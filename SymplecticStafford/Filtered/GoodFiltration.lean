#print axioms SymplecticStafford.Filtered.GoodFiltration.exhaustive_of_span_eq_top
#print axioms SymplecticStafford.Filtered.GoodFiltration.moduleFiltration
#print axioms SymplecticStafford.Filtered.GoodFiltration.finite_good_filtration
