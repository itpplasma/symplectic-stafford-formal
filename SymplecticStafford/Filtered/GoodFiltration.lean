module

public import Mathlib.Algebra.Group.Submonoid.Membership
public import Mathlib.LinearAlgebra.Span.Basic
public import SymplecticStafford.Filtered.ReesModule

@[expose] public section

/-!
# Finite good filtrations generated in bounded degrees

This file gives the elementary finite-generation construction that is needed
before any Noetherian Rees argument.  For a filtered ring `F`, module
generators `g i`, and explicit degree bounds `b i`, the `n`-th module layer is
the additive submonoid generated by all `a • g i` with `a ∈ F_k` and
`b i + k ≤ n`.

The construction is intentionally left-sided because `ModuleFiltrationData`
uses a left `Module R M`.  It proves exhaustiveness from the actual
`R`-span-generation hypothesis, while the layers themselves are additive
subobjects (as in a usual good filtration), not `R`-submodules.  No
Noetherianity, Rees localization, or associated-graded detection is inferred.
-/

namespace SymplecticStafford.Filtered

universe u v

variable {R : Type u} {M : Type v}
variable [Semiring R] [AddCommMonoid M] [Module R M]

namespace GoodFiltration

variable (F : FiltrationData R) (gens : Fin m → M) (bounds : Fin m → ℕ)

/-- The bounded elementary generators available in layer `n`. -/
def generatorSet (n : ℕ) : Set M :=
  {x | ∃ i : Fin m, ∃ k : ℕ, ∃ a : R,
    bounds i + k ≤ n ∧ a ∈ F.carrier k ∧ x = a • gens i}

/- The additive closure is the actual layer.  Keeping this as an
   `AddSubmonoid` records precisely the closure available from the filtered
   module axioms. -/
def carrier (n : ℕ) : AddSubmonoid M :=
  AddSubmonoid.closure (generatorSet F gens bounds n)

theorem generatorSet_mono {m n : ℕ} (hmn : m ≤ n) :
    generatorSet F gens bounds m ⊆ generatorSet F gens bounds n := by
  intro x hx
  change ∃ i : Fin _, ∃ k : ℕ, ∃ a : R,
    bounds i + k ≤ m ∧ a ∈ F.carrier k ∧ x = a • gens i at hx
  rcases hx with ⟨i, k, a, hak, ha, rfl⟩
  exact ⟨i, k, a, hak.trans hmn, ha, rfl⟩

theorem carrier_mono {m n : ℕ} (hmn : m ≤ n) :
    carrier F gens bounds m ≤ carrier F gens bounds n :=
  AddSubmonoid.closure_mono (generatorSet_mono F gens bounds hmn)

theorem smul_mem {i j : ℕ} {a : R} {x : M}
    (ha : a ∈ F.carrier i) (hx : x ∈ carrier F gens bounds j) :
    a • x ∈ carrier F gens bounds (i + j) := by
  induction hx using AddSubmonoid.closure_induction with
  | mem x hx =>
      change ∃ t : Fin _, ∃ k : ℕ, ∃ b : R,
        bounds t + k ≤ j ∧ b ∈ F.carrier k ∧ x = b • gens t at hx
      rcases hx with ⟨t, k, b, hbk, hb, rfl⟩
      apply AddSubmonoid.subset_closure
      refine ⟨t, i + k, a * b, ?_, F.mul_mem ha hb, ?_⟩
      · omega
      · exact smul_smul a b (gens t)
  | zero =>
      simpa only [smul_zero] using
        (AddSubmonoid.zero_mem (carrier F gens bounds (i + j)))
  | add x y hx hy hpx hpy =>
      simpa only [smul_add] using
        (AddSubmonoid.add_mem (carrier F gens bounds (i + j)) hpx hpy)

theorem generator_mem (i : Fin m) :
    gens i ∈ carrier F gens bounds (bounds i) := by
  apply AddSubmonoid.subset_closure
  exact ⟨i, 0, 1, by simp, F.one_mem, by simp⟩

theorem exhaustive_of_span_eq_top
    (hgen : Submodule.span R (Set.range gens) = ⊤) (x : M) :
    ∃ n : ℕ, x ∈ carrier F gens bounds n := by
  have hx : x ∈ Submodule.span R (Set.range gens) := by
    rw [hgen]
    trivial
  refine Submodule.span_induction (s := Set.range gens)
    (p := fun y _ => ∃ n : ℕ, y ∈ carrier F gens bounds n) ?_ ?_ ?_ ?_ hx
  · intro y hy
    rcases hy with ⟨i, rfl⟩
    exact ⟨bounds i, generator_mem F gens bounds i⟩
  · exact ⟨0, AddSubmonoid.zero_mem (carrier F gens bounds 0)⟩
  · intro y z _ _ hy hz
    rcases hy with ⟨ny, hyn⟩
    rcases hz with ⟨nz, hzn⟩
    refine ⟨max ny nz, ?_⟩
    apply AddSubmonoid.add_mem (carrier F gens bounds (max ny nz))
    · exact carrier_mono F gens bounds (Nat.le_max_left _ _) hyn
    · exact carrier_mono F gens bounds (Nat.le_max_right _ _) hzn
  · intro a y _ hy
    rcases hy with ⟨ny, hyn⟩
    rcases F.exhaustive a with ⟨ka, hka⟩
    exact ⟨ka + ny, smul_mem F gens bounds hka hyn⟩

/-!
The resulting object is an actual `ModuleFiltrationData`.  Its carrier is
the additive layer above, and all module compatibility is proved explicitly
from filtered multiplication and the finite span-generation hypothesis.
-/
def moduleFiltration
    (hgen : Submodule.span R (Set.range gens) = ⊤) :
    ModuleFiltrationData F M where
  carrier := fun n => carrier F gens bounds n
  zero_mem := AddSubmonoid.zero_mem _
  add_mem := by
    intro i j x y hx hy
    apply AddSubmonoid.add_mem _
    · exact carrier_mono F gens bounds (Nat.le_max_left _ _) hx
    · exact carrier_mono F gens bounds (Nat.le_max_right _ _) hy
  smul_mem := by
    intro i j a x ha hx
    exact smul_mem F gens bounds ha hx
  monotone := by
    intro i j hij
    exact carrier_mono F gens bounds hij
  exhaustive := exhaustive_of_span_eq_top F gens bounds hgen

@[simp] theorem moduleFiltration_carrier
    (hgen : Submodule.span R (Set.range gens) = ⊤) (n : ℕ) :
    (moduleFiltration F gens bounds hgen).carrier n = carrier F gens bounds n := rfl

theorem finite_good_filtration
    (hgen : Submodule.span R (Set.range gens) = ⊤) :
    ∃ G : ModuleFiltrationData F M,
      (∀ n : ℕ, G.carrier n = carrier F gens bounds n) ∧
      (∀ i : Fin m, gens i ∈ G.carrier (bounds i)) := by
  refine ⟨moduleFiltration F gens bounds hgen, ?_, ?_⟩
  · intro n
    rfl
  · intro i
    exact generator_mem F gens bounds i

end GoodFiltration

end SymplecticStafford.Filtered

