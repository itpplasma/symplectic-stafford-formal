module

public import AlgebraicAnalysis.Ore.Associativity
public import Mathlib.Algebra.Polynomial.Derivative
public import SymplecticStafford.Filtered.FullSymbolRightLocalization

@[expose] public section

/-!
# The fixed A₁ power-localization obstruction

The classical principal open of `H = x p` does not license localization at
the powers of the quantum lift `H`.  This file is intended to isolate the
first missing M03 bridge.  The final non-Ore statement is proved in the
coefficient-left derivation-Ore model, whose normal-form map is injective;
the only input about the Weyl relation is the checked relation
`p*x = x*p + 1`.

No statement here concerns S1.  The obstruction only says that the particular
power set generated by `x*p` is not a right Ore set.
-/

namespace SymplecticStafford.Filtered.PowerOreA1Obstruction

open Polynomial
open AlgebraicAnalysis
open AlgebraicAnalysis.OreDivision
open AlgebraicAnalysis.OreAssociativity

noncomputable section

/- The coefficient ring is `ℚ[x]`; its derivative and a new Ore variable `p`
   give the normal-form A₁ model `p*x = x*p + 1`. -/
def derivativeOre : OreDivisionDerivation ℚ[X] where
  toFun := Polynomial.derivative
  map_zero' := by simp
  map_add' := by intro a b; simp
  leibniz' := by
    intro a b
    simpa [mul_comm, add_comm] using (Polynomial.derivative_mul a b)

abbrev A1 := NormalOre derivativeOre

def x : A1 := normalCoefficient derivativeOre X
def p : A1 := normalVariable derivativeOre
def H : A1 := x * p

theorem p_mul_x : p * x = x * p + 1 := by
  have h := normalVariable_mul_coefficient derivativeOre X
  have hdx : derivativeOre X = 1 := by
    change Polynomial.derivative X = 1
    simp
  rw [hdx] at h
  simpa [p, x] using h

theorem x_mul_H : x * H = (H - 1) * x := by
  calc
    x * H = x * (x * p) := rfl
    _ = x * (p * x) - x := by
      rw [p_mul_x]
      noncomm_ring
    _ = (H - 1) * x := by
      rw [H, sub_mul]
      noncomm_ring

theorem x_mul_H_pow (n : ℕ) : x * H ^ n = (H - 1) ^ n * x := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ]
      calc
        x * (H ^ n * H) = (x * H ^ n) * H := by simp [mul_assoc]
        _ = ((H - 1) ^ n * x) * H := by rw [ih]
        _ = (H - 1) ^ n * (x * H) := by simp [mul_assoc]
        _ = (H - 1) ^ n * ((H - 1) * x) := by rw [x_mul_H]
        _ = ((H - 1) ^ n * (H - 1)) * x := by simp [mul_assoc]
        _ = ((H - 1) * (H - 1) ^ n) * x := by
          have hc : Commute ((H - 1) ^ n) (H - 1) :=
            (Commute.refl (H - 1)).pow_left n
          rw [hc.eq]
        _ = (H - 1) ^ (n + 1) * x := by rw [pow_succ']

/- The coefficient-left normal form exposes a nonzero top coefficient after
   multiplying by `x*p`.  This is the small PBW calculation needed below;
   using the library's monomial-top lemma keeps the cancellation check
   explicit. -/
lemma rightMul_X_top (q : Polynomial ℚ[X]) (hq : q ≠ 0) :
    (rightMul derivativeOre (monomial 1 X) q).coeff (1 + q.natDegree) =
      X * q.leadingCoeff := by
  rw [rightMul, Polynomial.coeff_sum, Polynomial.sum_def]
  have hddeg : (monomial 1 X : Polynomial ℚ[X]).natDegree = 1 := by simp
  have hqtop : q.natDegree ∈ q.support :=
    Polynomial.natDegree_mem_support_of_nonzero hq
  rw [Finset.sum_eq_single q.natDegree (by
    intro j hj hne
    have hj_le : j ≤ q.natDegree := Polynomial.le_natDegree_of_mem_supp j hj
    have hj_lt : j < q.natDegree := lt_of_le_of_ne hj_le hne
    have hdeg : (rightMulMonomial derivativeOre (monomial 1 X)
        (q.coeff j) j).degree ≤ (1 + j : WithBot ℕ) :=
      by simpa [hddeg] using
        (rightMulMonomial_degree_le derivativeOre (monomial 1 X) (q.coeff j) j)
    have hlt : (1 + j : WithBot ℕ) < (1 + q.natDegree : WithBot ℕ) := by
      exact_mod_cast Nat.add_lt_add_left hj_lt 1
    exact Polynomial.coeff_eq_zero_of_degree_lt (lt_of_le_of_lt hdeg hlt))
    (by simp [hqtop])]
  have hd0 : (monomial 1 X : Polynomial ℚ[X]) ≠ 0 := by simp
  rw [show (1 + q.natDegree : ℕ) =
      (monomial 1 X : Polynomial ℚ[X]).natDegree + q.natDegree by simp [hddeg]]
  rw [rightMulMonomial_coeff_top derivativeOre (monomial 1 X) hd0
    (q.coeff q.natDegree) q.natDegree]
  rw [show (monomial 1 X : Polynomial ℚ[X]).leadingCoeff = X by simp]
  rfl

lemma rightMul_X_ne_C (q : Polynomial ℚ[X]) :
    rightMul derivativeOre (monomial 1 X) q ≠ C X := by
  intro heq
  by_cases hq : q = 0
  · subst q
    rw [rightMul_zero] at heq
    have hc : (0 : Polynomial ℚ[X]) ≠ C X := by
      intro hz
      have hz0 := congrArg (fun r : Polynomial ℚ[X] => r.coeff 0) hz
      have : (0 : ℚ[X]) = X := by simpa using hz0
      exact Polynomial.X_ne_zero this.symm
    exact hc heq
  · have htop := rightMul_X_top q hq
    have hprod : X * q.leadingCoeff ≠ 0 :=
      mul_ne_zero (by simp) (Polynomial.leadingCoeff_ne_zero.mpr hq)
    have hcoeff := congrArg (fun r : Polynomial ℚ[X] =>
      r.coeff (1 + q.natDegree)) heq
    rw [htop] at hcoeff
    have hzero : (C X : Polynomial ℚ[X]).coeff (1 + q.natDegree) = 0 := by
      rw [Polynomial.coeff_C]
      simp [Nat.zero_ne_add_one]
    rw [hzero] at hcoeff
    exact hprod hcoeff

lemma normalForm_monomial_X :
    normalForm derivativeOre (monomial 1 X) = H := by
  rw [normalForm_monomial]
  simp [H, x, p]

lemma H_mul_ne_x (y : A1) : H * y ≠ x := by
  intro hy
  obtain ⟨q, hq⟩ := normalForm_surjective derivativeOre y
  have hn : normalForm derivativeOre (rightMul derivativeOre
      (monomial 1 X) q) = normalForm derivativeOre (C X) := by
    calc
      normalForm derivativeOre (rightMul derivativeOre (monomial 1 X) q) =
          normalForm derivativeOre (monomial 1 X) * normalForm derivativeOre q :=
        normalForm_mul derivativeOre _ _
      _ = H * y := by rw [normalForm_monomial_X, hq]
      _ = x := hy
      _ = normalForm derivativeOre (C X) := (normalForm_C derivativeOre X).symm
  have hpoly := normalForm_injective derivativeOre hn
  exact rightMul_X_ne_C q hpoly

set_option maxHeartbeats 1000000 in
lemma pow_sub_one_mul_x (n : ℕ) :
    ∃ c : A1, (H - 1) ^ n * x = H * c + (-1 : A1) ^ n * x := by
  induction n with
  | zero =>
      refine ⟨0, ?_⟩
      simp
  | succ n ih =>
      obtain ⟨c, hc⟩ := ih
      refine ⟨(H - 1) * c + (-1 : A1) ^ n * x, ?_⟩
      calc
        (H - 1) ^ (n + 1) * x = (H - 1) * ((H - 1) ^ n * x) := by
          rw [pow_succ']
          simp [mul_assoc]
        _ = (H - 1) * (H * c + (-1 : A1) ^ n * x) := by rw [hc]
        _ = (H - 1) * (H * c) + (H - 1) * ((-1 : A1) ^ n * x) := by
          rw [mul_add]
        _ = H * ((H - 1) * c) + (-1 : A1) ^ n * ((H - 1) * x) := by
          rcases neg_one_pow_eq_or A1 n with hs | hs
          · rw [hs]
            noncomm_ring
          · rw [hs]
            noncomm_ring
        _ = H * ((H - 1) * c) + (-1 : A1) ^ n * (x * H) := by
          rw [x_mul_H.symm]
        _ = H * ((H - 1) * c + (-1 : A1) ^ n * x) +
            (-1 : A1) ^ (n + 1) * x := by
          rw [x_mul_H]
          have hsnext : (-1 : A1) ^ (n + 1) = -((-1 : A1) ^ n) := by
            rw [pow_succ]
            noncomm_ring
          rcases neg_one_pow_eq_or A1 n with hs | hs
          · rw [hsnext, hs]
            noncomm_ring
          · rw [hsnext, hs]
            noncomm_ring

/- This is the conventional right-denominator clearing condition, with the
   denominator fixed to a power of `H`: `x * H^n = H * b`. -/
theorem no_right_power_clear :
    ¬ ∃ (n : ℕ) (b : A1), x * H ^ n = H * b := by
  intro hclear
  have no_clear_at : ∀ (n : ℕ) (b : A1), x * H ^ n ≠ H * b := by
    intro n b hEq0
    obtain ⟨c, hc⟩ := pow_sub_one_mul_x n
    have hEq : H * b = H * c + (-1 : A1) ^ n * x := by
      calc
        H * b = x * H ^ n := hEq0.symm
        _ = (H - 1) ^ n * x := x_mul_H_pow n
        _ = H * c + (-1 : A1) ^ n * x := hc
    rcases neg_one_pow_eq_or A1 n with hs | hs
    · have hfac : H * (b - c) = x := by
        calc
          H * (b - c) = H * b - H * c := by rw [mul_sub]
          _ = x := by rw [hEq, hs]; noncomm_ring
      exact H_mul_ne_x _ hfac
    · have hfac : H * (b - c) = -x := by
        calc
          H * (b - c) = H * b - H * c := by rw [mul_sub]
          _ = -x := by rw [hEq, hs]; noncomm_ring
      have hcontra : H * (-(b - c)) = x := by
        rw [mul_neg, hfac]
        simp
      exact H_mul_ne_x _ hcontra
  obtain ⟨n, b, hb⟩ := hclear
  exact no_clear_at n b hb

/- The exact localization-level boundary: the opposite denominator monoid
   required by `FullSymbolRightLocalization.Data` cannot carry an OreSet
   instance for the powers of this quantum lift. -/
theorem powers_H_not_right_ore :
    ¬ Nonempty (OreLocalization.OreSet
      (AlgebraicAnalysis.OreRightLocalization.oppositeSubmonoid
        (Submonoid.powers H))) := by
  intro hOre
  letI : OreLocalization.OreSet
      (AlgebraicAnalysis.OreRightLocalization.oppositeSubmonoid
        (Submonoid.powers H)) := Classical.choice hOre
  let t : AlgebraicAnalysis.OreRightLocalization.oppositeSubmonoid
      (Submonoid.powers H) :=
    ⟨MulOpposite.op H, Submonoid.mem_powers H⟩
  rcases OreLocalization.oreCondition (MulOpposite.op x) t with ⟨u, v, huv⟩
  rcases (Submonoid.mem_powers_iff (v : A1ᵐᵒᵖ).unop H).mp v.property with ⟨n, hn⟩
  apply no_right_power_clear
  refine ⟨n, u.unop, ?_⟩
  have hu := congrArg MulOpposite.unop huv
  change x * (v : A1ᵐᵒᵖ).unop = H * u.unop at hu
  rw [← hn] at hu
  exact hu

end
end SymplecticStafford.Filtered.PowerOreA1Obstruction
