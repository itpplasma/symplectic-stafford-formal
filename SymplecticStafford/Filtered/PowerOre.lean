import Mathlib.Algebra.Ring.Basic
import Mathlib.Data.Set.Defs
import SymplecticStafford.Filtered.Localization

/-!
# An algebraic power-Ore/fraction boundary

This module isolates the algebraic passage which a symbol localization must
eventually provide.  The denominator is an element of the original ring.  A
right Ore equation is required there, rather than inferred from a principal
symbol or from a completion.  The chart also carries an explicit two-sided
inverse for the denominator and a chart-wide right-clearing field.

The quotient below is the right-power fraction relation on pairs `(a,n)`,
with value `map a * inverse ^ n`.  We prove that the value is well-defined and
surjective, and that every original-ring right Ore witness gives the ordered
fraction product formula.  No Noetherianity, symbol-lifting, completion, or
universal source theorem is asserted.
-/

namespace SymplecticStafford.Filtered

universe u v

section Certificate

variable {R : Type u} [Semiring R]
variable {S : Type v} [Semiring S]

/-- The explicit algebraic data needed for a power-Ore chart.

`right_ore` lives in the original `R`; it is not a principal-symbol or
completed-chart assumption.  `right_clearable` is inherited from the
filtered-chart contract and is what makes the fraction passage onto the
specified chart.
-/
structure PowerOreLocalizationCertificate (R : Type u) (S : Type v)
    [Semiring R] [Semiring S]
    extends FilteredLocalizationCertificate R S where
  inverse : S
  denominator_mul_inverse : map denominator * inverse = 1
  inverse_mul_denominator : inverse * map denominator = 1
  right_ore : ∀ (a : R) (n : Nat),
    ∃ (k : Nat) (c : R), a * denominator ^ k = denominator ^ n * c

end Certificate

section Fractions

variable {R : Type u} [Semiring R]
variable {S : Type v} [Semiring S]

namespace PowerOreLocalizationCertificate

variable (C : PowerOreLocalizationCertificate R S)

private theorem denominator_commutes_with_inverse :
    Commute (C.map C.denominator) C.inverse := by
  exact (C.denominator_mul_inverse.trans C.inverse_mul_denominator.symm)

private theorem inverse_commutes_with_denominator :
    Commute C.inverse (C.map C.denominator) :=
  denominator_commutes_with_inverse C |>.symm

private theorem denominator_pow_mul_inverse_pow (n : Nat) :
    (C.map C.denominator) ^ n * C.inverse ^ n = 1 := by
  have h := (denominator_commutes_with_inverse C).mul_pow n
  rw [C.denominator_mul_inverse] at h
  simpa using h.symm

private theorem inverse_pow_mul_denominator_pow (n : Nat) :
    C.inverse ^ n * (C.map C.denominator) ^ n = 1 := by
  have h := (inverse_commutes_with_denominator C).mul_pow n
  rw [C.inverse_mul_denominator] at h
  simpa using h.symm

private theorem cancel_denominator_power_right (x : S) (q n : Nat) :
    x * (C.map C.denominator) ^ q * C.inverse ^ (q + n) =
      x * C.inverse ^ n := by
  rw [pow_add]
  calc
    x * (C.map C.denominator) ^ q * (C.inverse ^ q * C.inverse ^ n) =
        x * ((C.map C.denominator) ^ q * C.inverse ^ q) * C.inverse ^ n := by
          simp only [mul_assoc]
    _ = x * C.inverse ^ n := by
      rw [denominator_pow_mul_inverse_pow C q]
      simp

private theorem cancel_denominator_power_left (x : S) (n q : Nat) :
    C.inverse ^ (n + q) * (C.map C.denominator) ^ q * x =
      C.inverse ^ n * x := by
  rw [pow_add]
  calc
    (C.inverse ^ n * C.inverse ^ q) * (C.map C.denominator) ^ q * x =
        C.inverse ^ n * (C.inverse ^ q * (C.map C.denominator) ^ q) * x := by
          simp only [mul_assoc]
    _ = C.inverse ^ n * x := by
      rw [inverse_pow_mul_denominator_pow C q]
      simp

/-- The power set generated by the actual original-ring denominator. -/
def denominatorPowers : Set R := {s | ∃ n : Nat, s = C.denominator ^ n}

theorem one_mem_denominatorPowers : (1 : R) ∈ C.denominatorPowers := by
  exact ⟨0, by simp [denominatorPowers]⟩

theorem mul_mem_denominatorPowers {s t : R}
    (hs : s ∈ C.denominatorPowers) (ht : t ∈ C.denominatorPowers) :
    s * t ∈ C.denominatorPowers := by
  rcases hs with ⟨m, rfl⟩
  rcases ht with ⟨n, rfl⟩
  exact ⟨m + n, by rw [pow_add]⟩

/-- Right-power fractions before quotienting by common further powers. -/
abbrev FractionPair := R × Nat

/-- Equality after multiplying both right numerators by a common further
power.  The exponents retain the right-fraction order. -/
def fractionRel (p q : FractionPair (R := R)) : Prop :=
  ∃ k : Nat,
    p.1 * C.denominator ^ (q.2 + k) =
      q.1 * C.denominator ^ (p.2 + k)

theorem fractionRel_refl (p : FractionPair (R := R)) : fractionRel C p p := by
  exact ⟨0, rfl⟩

theorem fractionRel_symm {p q : FractionPair (R := R)} :
    fractionRel C p q → fractionRel C q p := by
  intro h
  rcases h with ⟨k, h⟩
  exact ⟨k, h.symm⟩

theorem fractionRel_trans {p q r : FractionPair (R := R)} :
    fractionRel C p q → fractionRel C q r → fractionRel C p r := by
  rcases p with ⟨a, n⟩
  rcases q with ⟨b, m⟩
  rcases r with ⟨c, ℓ⟩
  intro h₁ h₂
  rcases h₁ with ⟨k, h₁⟩
  rcases h₂ with ⟨j, h₂⟩
  refine ⟨m + k + j, ?_⟩
  calc
    a * C.denominator ^ (ℓ + (m + k + j)) =
        (a * C.denominator ^ (m + k)) * C.denominator ^ (ℓ + j) := by
          have he : ℓ + (m + k + j) = (m + k) + (ℓ + j) := by
            simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
          rw [he, pow_add]
          simp only [mul_assoc]
    _ = (b * C.denominator ^ (n + k)) * C.denominator ^ (ℓ + j) := by
          rw [h₁]
    _ = b * C.denominator ^ (n + k + (ℓ + j)) := by
          calc
            (b * C.denominator ^ (n + k)) * C.denominator ^ (ℓ + j) =
                b * (C.denominator ^ (n + k) * C.denominator ^ (ℓ + j)) := by
                  simp only [mul_assoc]
            _ = b * C.denominator ^ (n + k + (ℓ + j)) := by
              have hp := pow_add C.denominator (n + k) (ℓ + j)
              rw [hp]
    _ = b * C.denominator ^ (ℓ + j + (n + k)) := by
          congr 2
          simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
    _ = (b * C.denominator ^ (ℓ + j)) * C.denominator ^ (n + k) := by
          calc
            b * C.denominator ^ (ℓ + j + (n + k)) =
                b * (C.denominator ^ (ℓ + j) * C.denominator ^ (n + k)) := by
                  rw [pow_add]
            _ = (b * C.denominator ^ (ℓ + j)) * C.denominator ^ (n + k) := by
                  simp only [mul_assoc]
    _ = (c * C.denominator ^ (m + j)) * C.denominator ^ (n + k) := by
          rw [h₂]
    _ = c * C.denominator ^ (m + j + (n + k)) := by
          calc
            (c * C.denominator ^ (m + j)) * C.denominator ^ (n + k) =
                c * (C.denominator ^ (m + j) * C.denominator ^ (n + k)) := by
                  simp only [mul_assoc]
            _ = c * C.denominator ^ (m + j + (n + k)) := by
              have hp := pow_add C.denominator (m + j) (n + k)
              rw [hp]
    _ = c * C.denominator ^ (n + (m + k + j)) := by
          congr 2
          simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]

private def fractionSetoid : Setoid (FractionPair (R := R)) where
  r := fractionRel C
  iseqv := {
    refl := fractionRel_refl C
    symm := by intro p q; exact fractionRel_symm C
    trans := by intro p q r; exact fractionRel_trans C
  }

/-- The algebraic right-power fraction object. -/
def PowerFraction := Quotient (fractionSetoid C)

/-- The class of a numerator and a denominator exponent. -/
def fractionMk (a : R) (n : Nat) : C.PowerFraction :=
  Quotient.mk (fractionSetoid C) (a, n)

private theorem fraction_eval_pair_rel {p q : FractionPair (R := R)}
    (h : fractionRel C p q) :
    C.map p.1 * C.inverse ^ p.2 = C.map q.1 * C.inverse ^ q.2 := by
  rcases h with ⟨k, h⟩
  have hmap : C.map p.1 * (C.map C.denominator) ^ (q.2 + k) =
      C.map q.1 * (C.map C.denominator) ^ (p.2 + k) := by
    simpa only [map_mul, map_pow] using congrArg C.map h
  have hleft := congrArg (fun z : S => z * C.inverse ^
      (q.2 + p.2 + k)) hmap
  have hleft' : C.map p.1 * (C.map C.denominator) ^ (q.2 + k) *
          C.inverse ^ (q.2 + k + p.2) =
      C.map q.1 * (C.map C.denominator) ^ (p.2 + k) *
          C.inverse ^ (q.2 + k + p.2) := by
    convert hleft using 1 <;>
      simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
  calc
    C.map p.1 * C.inverse ^ p.2 =
        C.map p.1 * (C.map C.denominator) ^ (q.2 + k) *
          C.inverse ^ (q.2 + k + p.2) := by
      symm
      exact cancel_denominator_power_right C (C.map p.1)
        (q.2 + k) p.2
    _ = C.map q.1 * (C.map C.denominator) ^ (p.2 + k) *
          C.inverse ^ (q.2 + k + p.2) := by
      rw [hleft']
    _ = C.map q.1 * C.inverse ^ q.2 := by
      convert cancel_denominator_power_right C (C.map q.1)
        (p.2 + k) q.2 using 1 <;>
        simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]

/-- Evaluation of a quotient fraction in the chart. -/
def fractionEval : C.PowerFraction → S :=
  Quotient.lift (fun p : R × Nat => C.map p.1 * C.inverse ^ p.2)
    (by intro p q h; exact fraction_eval_pair_rel C h)

@[simp] theorem fractionEval_fractionMk (a : R) (n : Nat) :
    C.fractionEval (C.fractionMk a n) = C.map a * C.inverse ^ n := by
  rfl

/-- Every chart element has an algebraic right-power fraction representative. -/
theorem exists_fraction_representation (x : S) :
    ∃ (a : R) (n : Nat), x = C.map a * C.inverse ^ n := by
  rcases C.right_clearable x with ⟨n, a, h⟩
  refine ⟨a, n, ?_⟩
  calc
    x = x * 1 := by simp
    _ = x * ((C.map C.denominator) ^ n * C.inverse ^ n) := by
      rw [C.denominator_pow_mul_inverse_pow]
    _ = (x * (C.map C.denominator) ^ n) * C.inverse ^ n := by
      simp only [mul_assoc]
    _ = C.map a * C.inverse ^ n := by
      exact congrArg (fun z : S => z * C.inverse ^ n) h

theorem fractionEval_surjective : Function.Surjective C.fractionEval := by
  intro x
  rcases C.exists_fraction_representation x with ⟨a, n, hx⟩
  refine ⟨C.fractionMk a n, ?_⟩
  rw [fractionEval_fractionMk]
  exact hx.symm

private theorem inverse_pow_mul_map_of_right_ore
    (b : R) (n k : Nat) (c : R)
    (h : b * C.denominator ^ k = C.denominator ^ n * c) :
    C.inverse ^ n * C.map b = C.map c * C.inverse ^ k := by
  have hmap : C.map b * (C.map C.denominator) ^ k =
      (C.map C.denominator) ^ n * C.map c := by
    simpa only [map_mul, map_pow] using congrArg C.map h
  calc
    C.inverse ^ n * C.map b =
        C.inverse ^ n * C.map b *
          ((C.map C.denominator) ^ k * C.inverse ^ k) := by
      rw [C.denominator_pow_mul_inverse_pow]
      simp
    _ = C.inverse ^ n *
          (C.map b * (C.map C.denominator) ^ k) * C.inverse ^ k := by
      simp only [mul_assoc]
    _ = C.inverse ^ n *
          ((C.map C.denominator) ^ n * C.map c) * C.inverse ^ k := by
      rw [hmap]
    _ = C.map c * C.inverse ^ k := by
      rw [← mul_assoc (C.inverse ^ n),
        C.inverse_pow_mul_denominator_pow]
      simp only [one_mul, mul_assoc]

/-- Ordered multiplication of right fractions, supplied by an original-ring
right Ore witness.  The resulting numerator is `a * c`, and the resulting
power is `k + m`; no factors are commuted past one another. -/
theorem fractionEval_mul_of_right_ore
    (a b c : R) (n m k : Nat)
    (h : b * C.denominator ^ k = C.denominator ^ n * c) :
    (C.map a * C.inverse ^ n) * (C.map b * C.inverse ^ m) =
      C.map (a * c) * C.inverse ^ (k + m) := by
  have hmoved := inverse_pow_mul_map_of_right_ore C b n k c h
  calc
    (C.map a * C.inverse ^ n) * (C.map b * C.inverse ^ m) =
        C.map a * (C.inverse ^ n * C.map b) * C.inverse ^ m := by
      simp only [mul_assoc]
    _ = C.map a * (C.map c * C.inverse ^ k) * C.inverse ^ m := by
      rw [hmoved]
    _ = C.map (a * c) * C.inverse ^ (k + m) := by
      rw [pow_add, map_mul]
      simp only [mul_assoc]

theorem fractionEval_mul_of_ore_witness
    (a b : R) (n m : Nat) :
    ∃ (k : Nat) (c : R),
      b * C.denominator ^ k = C.denominator ^ n * c ∧
      (C.map a * C.inverse ^ n) * (C.map b * C.inverse ^ m) =
        C.map (a * c) * C.inverse ^ (k + m) := by
  rcases C.right_ore b n with ⟨k, c, h⟩
  exact ⟨k, c, h, fractionEval_mul_of_right_ore C a b c n m k h⟩

end PowerOreLocalizationCertificate

end Fractions

end SymplecticStafford.Filtered

#print axioms SymplecticStafford.Filtered.PowerOreLocalizationCertificate.fractionEval_surjective
#print axioms SymplecticStafford.Filtered.PowerOreLocalizationCertificate.fractionEval_mul_of_ore_witness
