import Mathlib.Algebra.DirectSum.Ring
import Mathlib.RingTheory.Noetherian.Basic
import SymplecticStafford.Filtered.M01StructuralClass
import SymplecticStafford.Filtered.RingFiltrationBridge
import SymplecticStafford.Filtered.ReesRing

/-!
# The actual associated graded ring and its right homogeneous ideals

`M01StructuralClass` constructs the consecutive quotient layers and the
filtered multiplication between them.  This file makes the missing direct
sum object explicit.  Every multiplication law is proved on representatives
and every change of degree is transported along the corresponding equality
of natural numbers.  The order of factors is never changed.

The finite-generation result below is deliberately right-sided: a right ideal
is a submodule over the opposite ring.  It is the graded-induction step that
is needed by a filtered-to-Rees proof.  It applies to an actual homogeneous
right ideal of the actual direct-sum ring; no Rees Noetherianity or finite
homogeneous-lifting callback is used.

The representative section at the end lifts individual classes to Rees terms.
The final sections construct the exhaustive coefficient filtration of the
actual Rees ring, define the right ideal generated by the actual symbols of
an arbitrary right ideal, and prove descending reduction for nested ideals
whose actual symbol ranges agree. A general right ideal need not contain
the individual homogeneous summands of one of its elements. In particular,
a span of symbols is not yet proved to have symbol lifts. The terminal
Noetherianity producer remains open; its exact statement is recorded below.
-/

namespace SymplecticStafford.Filtered

universe u

noncomputable section

variable {R : Type u} [Ring R]

open scoped DirectSum

/- The historical right-ideal layers can only describe the constant
   filtration.  Keep their public API, but make that restriction explicit. -/
namespace RingFiltrationData

theorem carrier_eq_top (F : RingFiltrationData (R := R)) (n : ℕ) :
    F.carrier n = ⊤ := by
  apply top_unique
  intro a _
  have h1 : (1 : R) ∈ F.carrier n :=
    F.monotone (Nat.zero_le n) F.one_mem
  simpa using (F.carrier n).smul_mem (MulOpposite.op a) h1

/-- Explicit forgetting bridge; new producer inputs use additive layers. -/
def toAdditiveFilteredRingData (F : RingFiltrationData (R := R)) :
    AdditiveFilteredRingData R where
  carrier := fun n => (F.carrier n).toAddSubgroup
  one_mem := F.one_mem
  mul_mem := F.mul_mem
  monotone := F.monotone
  exhaustive := F.exhaustive

end RingFiltrationData

namespace AdditiveFilteredRingData

variable (F : AdditiveFilteredRingData R)

/- The actual graded carrier.  The quotient in degree `n` is the quotient
   supplied by `M01StructuralClass`, not an abstract placeholder. -/
abbrev actualAssociatedGraded :=
  ⨁ n : ℕ, associatedLayer F n

def associatedOne : associatedLayer F 0 :=
  associatedClass F 0 1 F.one_mem

/- The following four laws are representative calculations.  They are kept
   as separate lemmas so that the DirectSum ring structure below has no
   hidden algebraic assumption. -/
theorem associatedLayerMul_zero_left (i j : ℕ)
    (y : associatedLayer F j) :
    associatedLayerMul F i j 0 y = 0 := by
  induction y using Quotient.inductionOn with
  | _ b =>
      simp [associatedLayerMul, associatedClass]

theorem associatedLayerMul_zero_right (i j : ℕ)
    (x : associatedLayer F i) :
    associatedLayerMul F i j x 0 = 0 := by
  induction x using Quotient.inductionOn with
  | _ a =>
      simp [associatedLayerMul, associatedClass]

theorem associatedLayerMul_add_left (i j : ℕ)
    (x x' : associatedLayer F i) (y : associatedLayer F j) :
    associatedLayerMul F i j (x + x') y =
      associatedLayerMul F i j x y + associatedLayerMul F i j x' y := by
  induction x using Quotient.inductionOn with
  | _ a =>
      induction x' using Quotient.inductionOn with
      | _ c =>
          induction y using Quotient.inductionOn with
          | _ b =>
              simp [associatedLayerMul, associatedClass, add_mul]

theorem associatedLayerMul_add_right (i j : ℕ)
    (x : associatedLayer F i) (y y' : associatedLayer F j) :
    associatedLayerMul F i j x (y + y') =
      associatedLayerMul F i j x y + associatedLayerMul F i j x y' := by
  induction x using Quotient.inductionOn with
  | _ a =>
      induction y using Quotient.inductionOn with
      | _ b =>
          induction y' using Quotient.inductionOn with
          | _ d =>
              simp [associatedLayerMul, associatedClass, mul_add]

private theorem associatedClass_sigma_eq {i j : ℕ} (hij : i = j)
    {a b : R} (hab : a = b) (ha : a ∈ F.carrier i)
    (hb : b ∈ F.carrier j) :
    Sigma.mk i (associatedClass F i a ha) =
      Sigma.mk j (associatedClass F j b hb) := by
  subst j
  subst b
  rfl

theorem associatedLayerMul_one_left (i : ℕ)
    (x : associatedLayer F i) :
    Sigma.mk (0 + i) (associatedLayerMul F 0 i (associatedOne F) x) =
      Sigma.mk i x := by
  induction x using Quotient.inductionOn with
  | _ a =>
      change Sigma.mk (0 + i)
          (associatedClass F (0 + i) (1 * a.1) _) =
        Sigma.mk i (associatedClass F i a.1 a.2)
      exact associatedClass_sigma_eq F (zero_add i) (one_mul a.1) _ _

theorem associatedLayerMul_one_right (i : ℕ)
    (x : associatedLayer F i) :
    Sigma.mk (i + 0) (associatedLayerMul F i 0 x (associatedOne F)) =
      Sigma.mk i x := by
  induction x using Quotient.inductionOn with
  | _ a =>
      change Sigma.mk (i + 0)
          (associatedClass F (i + 0) (a.1 * 1) _) =
        Sigma.mk i (associatedClass F i a.1 a.2)
      exact associatedClass_sigma_eq F (add_zero i) (mul_one a.1) _ _

theorem associatedLayerMul_assoc (i j k : ℕ)
    (x : associatedLayer F i) (y : associatedLayer F j)
    (z : associatedLayer F k) :
    Sigma.mk ((i + j) + k)
        (associatedLayerMul F (i + j) k
          (associatedLayerMul F i j x y) z) =
      Sigma.mk (i + (j + k))
        (associatedLayerMul F i (j + k) x
          (associatedLayerMul F j k y z)) := by
  induction x using Quotient.inductionOn with
  | _ a =>
      induction y using Quotient.inductionOn with
      | _ b =>
          induction z using Quotient.inductionOn with
          | _ c =>
              change Sigma.mk ((i + j) + k)
                  (associatedClass F ((i + j) + k) ((a.1 * b.1) * c.1) _) =
                Sigma.mk (i + (j + k))
                  (associatedClass F (i + (j + k)) (a.1 * (b.1 * c.1)) _)
              exact associatedClass_sigma_eq F (Nat.add_assoc i j k)
                (mul_assoc a.1 b.1 c.1) _ _

/- A genuine graded ring structure on the direct sum of the actual layers.
   `DirectSum.GRing` is noncommutative: its multiplication keeps the order
   `x` followed by `y`. -/
instance actualAssociatedGradedGRing :
    DirectSum.GRing (fun n : ℕ => associatedLayer F n) where
  mul := fun {i j} x y => associatedLayerMul F i j x y
  mul_zero := by
    intro i j x
    exact associatedLayerMul_zero_right F i j x
  zero_mul := by
    intro i j y
    exact associatedLayerMul_zero_left F i j y
  mul_add := by
    intro i j x y z
    exact associatedLayerMul_add_right F i j x y z
  add_mul := by
    intro i j x y z
    exact associatedLayerMul_add_left F i j x y z
  one := associatedOne F
  one_mul := by
    intro x
    exact associatedLayerMul_one_left F x.1 x.2
  mul_one := by
    intro x
    exact associatedLayerMul_one_right F x.1 x.2
  mul_assoc := by
    intro x y z
    exact associatedLayerMul_assoc F x.1 y.1 z.1 x.2 y.2 z.2
  natCast := fun n => n • associatedOne F
  natCast_zero := by simp
  natCast_succ := by
    intro n
    simp [add_comm]
  intCast := fun z => z • associatedOne F
  intCast_ofNat := by
    intro n
    simp
  intCast_negSucc_ofNat := by
    intro n
    simp

noncomputable instance actualAssociatedGradedRing :
    Ring (actualAssociatedGraded F) := by
  infer_instance

@[simp] theorem actualAssociatedGraded_of_mul_of
    {i j : ℕ} (x : associatedLayer F i) (y : associatedLayer F j) :
    DirectSum.of (fun n : ℕ => associatedLayer F n) i x *
        DirectSum.of (fun n : ℕ => associatedLayer F n) j y =
      DirectSum.of (fun n : ℕ => associatedLayer F n) (i + j)
        (associatedLayerMul F i j x y) := by
  rw [DirectSum.of_mul_of]

end AdditiveFilteredRingData

namespace ActualAssociatedGraded

open AdditiveFilteredRingData

variable (F : AdditiveFilteredRingData R)

abbrev Carrier := AdditiveFilteredRingData.actualAssociatedGraded F

/- A homogeneous element is one direct-sum component.  This definition also
   permits the zero component, which is useful when a finite support is
   enlarged during a span calculation. -/
def IsHomogeneous (x : Carrier F) : Prop :=
  ∃ n : ℕ, ∃ a : associatedLayer F n,
    x = DirectSum.of (fun n : ℕ => associatedLayer F n) n a

/- Right ideals are submodules over the opposite ring.  The component field
   is the exact homogeneous-ideal condition used by the finite induction. -/
structure HomogeneousRightIdeal where
  carrier : Submodule (Carrier F)ᵐᵒᵖ (Carrier F)
  component_mem : ∀ {x : Carrier F}, x ∈ carrier → ∀ n : ℕ,
    DirectSum.of (fun n : ℕ => associatedLayer F n) n (x n) ∈ carrier

theorem homogeneous_mem
    (J : HomogeneousRightIdeal F) {x : Carrier F} (hx : x ∈ J.carrier)
    (n : ℕ) :
    IsHomogeneous F (DirectSum.of (fun n : ℕ => associatedLayer F n) n (x n)) := by
  exact ⟨n, x n, rfl⟩

/- The direct-sum component sum used to replace an arbitrary finite generator
   by finitely many homogeneous generators. -/
theorem exists_finset_homogeneous_generators
    [IsNoetherian (Carrier F)ᵐᵒᵖ (Carrier F)]
    (J : HomogeneousRightIdeal F) :
    ∃ t : Finset (Carrier F),
      (∀ x ∈ t, x ∈ J.carrier ∧ IsHomogeneous F x) ∧
      Submodule.span (Carrier F)ᵐᵒᵖ (t : Set (Carrier F)) = J.carrier := by
  classical
  obtain ⟨S, hSfinite, hSspan⟩ :=
    Submodule.fg_def.mp (IsNoetherian.noetherian J.carrier)
  let s : Finset (Carrier F) := hSfinite.toFinset
  let t : Finset (Carrier F) :=
    s.biUnion (fun x => x.support.image
      (fun n => DirectSum.of (fun n : ℕ => associatedLayer F n) n (x n)))
  have hs : (S : Set (Carrier F)) = (s : Set (Carrier F)) := by
    exact (Set.Finite.coe_toFinset hSfinite).symm
  have ht_mem : ∀ x ∈ t, x ∈ J.carrier ∧ IsHomogeneous F x := by
    intro x hx
    simp only [t, Finset.mem_biUnion, Finset.mem_image] at hx
    obtain ⟨y, hy, n, hn, rfl⟩ := hx
    have hyJ : y ∈ J.carrier := by
      rw [← hSspan]
      apply Submodule.subset_span
      have hyS : y ∈ S := by
        rw [hs]
        exact hy
      exact hyS
    exact ⟨J.component_mem hyJ n, homogeneous_mem F J hyJ n⟩
  have hspan_le :
      Submodule.span (Carrier F)ᵐᵒᵖ (t : Set (Carrier F)) ≤ J.carrier := by
    apply Submodule.span_le.2
    intro x hx
    exact (ht_mem x (by simpa using hx)).1
  have hgen_le :
      J.carrier ≤ Submodule.span (Carrier F)ᵐᵒᵖ (t : Set (Carrier F)) := by
    rw [← hSspan]
    apply Submodule.span_le.2
    intro x hx
    rw [← DirectSum.sum_support_of x]
    apply Submodule.sum_mem
    intro n hn
    apply Submodule.subset_span
    simp only [t, Finset.mem_biUnion, Finset.mem_image]
    have hxs : x ∈ s := by
      rw [← hs]
      exact hx
    exact ⟨x, hxs, n, hn, rfl⟩
  refine ⟨t, ht_mem, le_antisymm hspan_le hgen_le⟩

/- A chosen representative gives an honest bounded homogeneous Rees term.
   This is a section of the quotient map, not an assumed symbol-lifting map. -/
noncomputable def representative (n : ℕ) (x : associatedLayer F n) : F.carrier n :=
  Quotient.out x

theorem associatedClass_representative (n : ℕ)
    (x : associatedLayer F n) :
    associatedClass F n (representative F n x)
        (representative F n x).property = x := by
  exact Quotient.out_eq x

noncomputable def homogeneousReesLift (n : ℕ) (x : associatedLayer F n) :
    ReesRing (AdditiveFilteredRingData.toNegFiltrationData F) :=
  ReesRing.monomial (AdditiveFilteredRingData.toNegFiltrationData F) n
    (representative F n x) (representative F n x).property

@[simp] theorem homogeneousReesLift_coeff (n : ℕ) (x : associatedLayer F n) :
    ((homogeneousReesLift F n x : ReesRing
      (AdditiveFilteredRingData.toNegFiltrationData F) : ReesPolynomial R).coeff n) =
      (representative F n x : R) := by
  change (SkewPolynomial.monomial n (representative F n x : R)).coeff n =
    (representative F n x : R)
  rw [SkewPolynomial.coeff_monomial]
  simp

end ActualAssociatedGraded

namespace ReesCoefficientFiltration

open AdditiveFilteredRingData
open scoped BigOperators

variable (F : AdditiveFilteredRingData R)

abbrev Rees := ReesRing F.toNegFiltrationData

/-- Bound the filtration degree of every coefficient, independently of its
polynomial exponent. The Rees condition still bounds coefficient `k` by `F_k`. -/
def layer (n : ℕ) : AddSubgroup (Rees F) where
  carrier := {p | ∀ k : ℕ, (p : ReesPolynomial R).coeff k ∈ F.carrier n}
  zero_mem' := by
    intro k
    exact F.zero_mem n
  add_mem' := by
    intro p q hp hq k
    change ((p : ReesPolynomial R) + q).coeff k ∈ F.carrier n
    rw [SkewPolynomial.coeff_add]
    exact (F.carrier n).add_mem (hp k) (hq k)
  neg_mem' := by
    intro p hp k
    change (-(p : ReesPolynomial R)).coeff k ∈ F.carrier n
    rw [SkewPolynomial.coeff_neg]
    exact (F.carrier n).neg_mem (hp k)

theorem layer_monotone : Monotone (layer F) := by
  intro i j hij p hp k
  exact F.monotone hij (hp k)

theorem layer_mul {i j : ℕ} {p q : Rees F}
    (hp : p ∈ layer F i) (hq : q ∈ layer F j) :
    p * q ∈ layer F (i + j) := by
  intro k
  change SkewMonoidAlgebra.coeff
    ((p : ReesPolynomial R) * q) (Multiplicative.ofAdd k) ∈ F.carrier (i + j)
  rw [SkewMonoidAlgebra.coeff_mul]
  apply (F.carrier (i + j)).sum_mem
  intro a ha
  apply (F.carrier (i + j)).sum_mem
  intro b hb
  split_ifs
  · change (p : ReesPolynomial R).coeff a.toAdd *
      (q : ReesPolynomial R).coeff b.toAdd ∈ F.carrier (i + j)
    exact F.mul_mem (hp a.toAdd) (hq b.toAdd)
  · exact F.zero_mem (i + j)

/-- Finite polynomial support supplies an actual natural-number bound.
No completeness or separatedness hypothesis is needed for this filtration. -/
theorem layer_exhaustive (p : Rees F) : ∃ n : ℕ, p ∈ layer F n := by
  classical
  refine ⟨(SkewPolynomial.support (p : ReesPolynomial R)).sup id, ?_⟩
  intro k
  by_cases hk : k ∈ SkewPolynomial.support (p : ReesPolynomial R)
  · exact F.monotone (Finset.le_sup hk) (p.property k)
  · rw [SkewPolynomial.notMem_support_iff.mp hk]
    exact F.zero_mem _

def filtration : AdditiveFilteredRingData (Rees F) where
  carrier := layer F
  one_mem := by
    intro k
    change (1 : ReesPolynomial R).coeff k ∈ F.carrier 0
    rw [SkewPolynomial.coeff_one]
    split_ifs
    · exact F.one_mem
    · exact F.zero_mem 0
  mul_mem := layer_mul F
  monotone := layer_monotone F
  exhaustive := layer_exhaustive F

end ReesCoefficientFiltration

namespace FilteredRightIdealSymbols

open AdditiveFilteredRingData

variable (F : AdditiveFilteredRingData R)

/-- Actual degree-`n` symbols of elements of an arbitrary right ideal.
The witness belongs to the whole ideal; no homogeneous-piece membership
is required of that ideal. Allowing nonminimal bounds contributes only zero. -/
def symbols (I : Submodule Rᵐᵒᵖ R) (n : ℕ) : Set (associatedLayer F n) :=
  {x | ∃ a : R, ∃ ha : a ∈ F.carrier n,
    a ∈ I ∧ associatedClass F n a ha = x}

/-- Each exact symbol range is an additive subgroup of the actual layer. -/
def symbolAddSubgroup (I : Submodule Rᵐᵒᵖ R) (n : ℕ) :
    AddSubgroup (associatedLayer F n) where
  carrier := symbols F I n
  zero_mem' := ⟨0, F.zero_mem n, I.zero_mem, rfl⟩
  add_mem' := by
    intro x y hx hy
    obtain ⟨a, ha, hI, rfl⟩ := hx
    obtain ⟨b, hb, hJ, rfl⟩ := hy
    exact ⟨a + b, (F.carrier n).add_mem ha hb, I.add_mem hI hJ, rfl⟩
  neg_mem' := by
    intro x hx
    obtain ⟨a, ha, hI, rfl⟩ := hx
    exact ⟨-a, (F.carrier n).neg_mem ha, I.neg_mem hI, rfl⟩

/-- Right multiplication of an exact symbol by any homogeneous class has
an actual lift: multiply the original ideal element by a representative.
No commutativity and no homogeneous decomposition of the ideal is used. -/
theorem mul_mem_symbols (I : Submodule Rᵐᵒᵖ R) (i j : ℕ)
    {x : associatedLayer F i} (hx : x ∈ symbols F I i)
    (y : associatedLayer F j) :
    associatedLayerMul F i j x y ∈ symbols F I (i + j) := by
  obtain ⟨a, ha, hI, rfl⟩ := hx
  induction y using Quotient.inductionOn with
  | _ b =>
      refine ⟨a * b.1, F.mul_mem ha b.2, ?_, rfl⟩
      exact I.smul_mem (MulOpposite.op b.1) hI

/-- The right ideal generated by all actual symbols. This definition alone
must not be read as asserting that its homogeneous components have lifts. -/
def leadingSymbolRightIdeal (I : Submodule Rᵐᵒᵖ R) :
    Submodule (actualAssociatedGraded F)ᵐᵒᵖ (actualAssociatedGraded F) :=
  Submodule.span (actualAssociatedGraded F)ᵐᵒᵖ
    {x | ∃ n : ℕ, ∃ a ∈ symbols F I n,
      DirectSum.of (fun n : ℕ => associatedLayer F n) n a = x}

theorem symbol_mem_leadingSymbolRightIdeal (I : Submodule Rᵐᵒᵖ R)
    (n : ℕ) (a : R) (ha : a ∈ F.carrier n) (hI : a ∈ I) :
    DirectSum.of (fun n : ℕ => associatedLayer F n) n
      (associatedClass F n a ha) ∈ leadingSymbolRightIdeal F I := by
  apply Submodule.subset_span
  exact ⟨n, associatedClass F n a ha, ⟨a, ha, hI, rfl⟩, rfl⟩

/-- Equality of two concrete symbols lowers the filtration bound of their
remainder. This includes degree zero, whose predecessor is the zero group. -/
theorem sub_mem_predecessor_of_symbol_eq (n : ℕ) (a b : R)
    (ha : a ∈ F.carrier n) (hb : b ∈ F.carrier n)
    (h : associatedClass F n a ha = associatedClass F n b hb) :
    a - b ∈ predecessor F n := by
  exact (Submodule.Quotient.eq (layerSubmodule F n)).mp h

/-- Finite descending reduction with exact symbol ranges. Each induction
step subtracts an element of `J` with the same symbol and decreases the
natural-number bound. This is a comparison theorem, not an assumption of
finite generation or of symbol lifting for a span. -/
theorem le_of_symbols_subset (I J : Submodule Rᵐᵒᵖ R)
    (hJI : J ≤ I)
    (h : ∀ n : ℕ, symbols F I n ⊆ symbols F J n) : I ≤ J := by
  have reduce : ∀ n : ℕ, ∀ a : R, a ∈ F.carrier n → a ∈ I → a ∈ J := by
    intro n
    induction n with
    | zero =>
        intro a ha hI
        obtain ⟨b, hb, hbJ, heq⟩ := h 0 ⟨a, ha, hI, rfl⟩
        have hlow := sub_mem_predecessor_of_symbol_eq F 0 a b ha hb heq.symm
        have hab : a - b = 0 := by
          simpa [predecessor] using hlow
        rw [sub_eq_zero.mp hab]
        exact hbJ
    | succ n ih =>
        intro a ha hI
        obtain ⟨b, hb, hbJ, heq⟩ := h (n + 1) ⟨a, ha, hI, rfl⟩
        have hlow := sub_mem_predecessor_of_symbol_eq F (n + 1) a b ha hb heq.symm
        have hbI : b ∈ I := hJI hbJ
        have hdJ := ih (a - b) (by simpa [predecessor] using hlow)
          (I.sub_mem hI hbI)
        simpa using J.add_mem hdJ hbJ
  intro a ha
  obtain ⟨n, hn⟩ := F.exhaustive a
  exact reduce n a hn ha

end FilteredRightIdealSymbols

namespace ReesCoefficientFiltration

variable (F : AdditiveFilteredRingData R)

/-- The actual symbol-generated right ideal attached to an arbitrary Rees
right ideal, using the coefficient filtration constructed above. -/
abbrev leadingSymbolRightIdeal (I : Submodule (Rees F)ᵐᵒᵖ (Rees F)) :=
  FilteredRightIdealSymbols.leadingSymbolRightIdeal (filtration F) I

/-- Reduction applies to arbitrary nested Rees right ideals. -/
theorem le_of_symbols_subset
    (I J : Submodule (Rees F)ᵐᵒᵖ (Rees F)) (hJI : J ≤ I)
    (h : ∀ n : ℕ,
      FilteredRightIdealSymbols.symbols (filtration F) I n ⊆
        FilteredRightIdealSymbols.symbols (filtration F) J n) : I ≤ J :=
  FilteredRightIdealSymbols.le_of_symbols_subset (filtration F) I J hJI h

end ReesCoefficientFiltration

/- Remaining terminal theorem (not asserted):

  (F : AdditiveFilteredRingData R)
  [IsNoetherian (F.actualAssociatedGraded)ᵐᵒᵖ F.actualAssociatedGraded] :
  IsNoetherian (ReesRing F.toNegFiltrationData)ᵐᵒᵖ
    (ReesRing F.toNegFiltrationData)

The natural-number filtration is already exhaustive and bounded below;
no additional separatedness or completeness assumption is necessary.
The missing proof must identify the associated graded of `filtration F`
with the central polynomial ring over `F.actualAssociatedGraded`, establish
its right Noetherianity, and show that the homogeneous components of the
symbol-generated ideal have actual lifts in the original ideal. That last
step is what permits finite generation of the symbol ideal to feed the
proved descending reduction. None of these steps is supplied as a callback.
-/

end

