module

public import Mathlib.Algebra.Ring.Basic
public import Mathlib.Data.Finset.Basic
public import Mathlib.Data.Set.Defs
public import SymplecticStafford.Ordered.FiniteGenerationBridge

@[expose] public section

/-!
# A finite-generator characteristic-support union

The ordered M08 files deliberately leave characteristic support abstract. This
file records one useful way to consume that boundary without turning the
support-union conclusion into an assumption. A support datum supplies two
separate facts: finite generators cover the common-colon support by principal
generator supports, and outside the two branch supports each such principal
generator is absent. The theorem derives the union by a finite-generator
argument. The ordered common-colon pencil certificate is returned separately
and keeps every factor in the original order.
-/

namespace SymplecticStafford.Ordered

universe u v

variable {R : Type u} [Ring R]

/- The principal right ideal generated by one element, expressed using the
   project's explicit two-generator right-ideal carrier. -/
def principalRightIdeal (g : R) : RightIdeal (R := R) :=
  twoGeneratedRightIdeal g 0

def generatorSupportUnion {X : Type v}
    (support : RightIdeal (R := R) → Set X) (gs : Finset R) : Set X :=
  {x | ∃ g ∈ gs, x ∈ support (principalRightIdeal g)}

theorem mem_generatorSupportUnion_iff {X : Type v}
    (support : RightIdeal (R := R) → Set X) (gs : Finset R) (x : X) :
    x ∈ generatorSupportUnion support gs ↔
      ∃ g ∈ gs, x ∈ support (principalRightIdeal g) := Iff.rfl

/- The finite-generator part of the characteristic-support interface. -/
def FiniteGeneratorSupportCover {X : Type v}
    (support : RightIdeal (R := R) → Set X)
    (d F G : R) (W : FiniteRightGeneration (R := R)
      (commonRightIdeal d F G)) : Prop :=
  support (commonRightIdeal d F G) ⊆
    generatorSupportUnion support W.generators

/- The branch part is stated for an actual affine-pencil certificate and an
   actual auxiliary-divisor relation. -/
structure CharacteristicSupportBranchHypothesis {X : Type v}
    (support : RightIdeal (R := R) → Set X)
    (d F G L : R)
    (W : FiniteRightGeneration (R := R) (commonRightIdeal d F G)) where
  generator_cover : FiniteGeneratorSupportCover support d F G W
  outside_branches_excludes_generator :
    ∀ {x : X} {g : R}, g ∈ W.generators →
      (∀ t : R, (∀ y : R, t * y = y * t) →
        ∃ r s : R, g = d * r + (F + t * G) * d * s) →
      (∃ C : R, F * d * L = d * C) →
      x ∉ support (twoGeneratedRightIdeal d F) →
      x ∉ support (twoGeneratedRightIdeal (d * L) G) →
      x ∉ support (principalRightIdeal g)

/- Every finite generator has an affine certificate, obtained from the
   ordered common-colon pencil inclusion rather than postulated. -/
theorem affine_certificate_for_common_generator
    (d F G : R)
    (W : FiniteRightGeneration (R := R) (commonRightIdeal d F G))
    (g : R) (hg : g ∈ W.generators) (t : R)
    (hcentral : ∀ y : R, t * y = y * t) :
    ∃ r s : R, g = d * r + (F + t * G) * d * s := by
  have hmem : g ∈ (twoGeneratedRightIdeal d (F + t * G)).carrier :=
    common_generator_mem_affine d F G t W hcentral g hg
  exact hmem

/- The geometric support-union conclusion from explicit finite-generator and
   characteristic-support hypotheses. -/
theorem support_union_of_finite_generators
    {X : Type v} (support : RightIdeal (R := R) → Set X)
    (d F G L : R)
    (W : FiniteRightGeneration (R := R) (commonRightIdeal d F G))
    (A : AuxiliaryDivisorRelation d F G L)
    (H : CharacteristicSupportBranchHypothesis support d F G L W)
    (hcentral : ∀ t y : R, t * y = y * t) :
    support (commonRightIdeal d F G) ⊆
      support (twoGeneratedRightIdeal d F) ∪
        support (twoGeneratedRightIdeal (d * L) G) := by
  intro x hx
  rcases H.generator_cover hx with ⟨g, hg, hgx⟩
  by_cases h₁ : x ∈ support (twoGeneratedRightIdeal d F)
  · exact Or.inl h₁
  by_cases h₂ : x ∈ support (twoGeneratedRightIdeal (d * L) G)
  · exact Or.inr h₂
  exact False.elim ((H.outside_branches_excludes_generator hg
    (fun t ht => affine_certificate_for_common_generator d F G W g hg t
      (hcentral t))
    ⟨A.C, A.relation⟩ h₁ h₂) hgx)

/- The exact pencil identity is exposed as a reusable companion output. -/
theorem common_colon_pencil_certificate
    (d F G k t : R)
    (hk : k ∈ commonColon d G)
    (hcentral : ∀ y : R, t * y = y * t) :
    ∃ c : R,
      G * d * k = d * c ∧
        F * d * k = d * (-t * c) + (F + t * G) * d * k := by
  rcases hk with ⟨c, hc⟩
  exact ⟨c, hc, central_commonColon_identity d F G k c t hc hcentral⟩

/- A combined result is convenient for consumers. -/
theorem support_union_with_common_colon_certificates
    {X : Type v} (support : RightIdeal (R := R) → Set X)
    (d F G L : R)
    (W : FiniteRightGeneration (R := R) (commonRightIdeal d F G))
    (A : AuxiliaryDivisorRelation d F G L)
    (H : CharacteristicSupportBranchHypothesis support d F G L W)
    (hcentral : ∀ t y : R, t * y = y * t) :
    (support (commonRightIdeal d F G) ⊆
      support (twoGeneratedRightIdeal d F) ∪
        support (twoGeneratedRightIdeal (d * L) G)) ∧
      (∀ k : R, k ∈ commonColon d G →
        ∀ t : R, (∀ y : R, t * y = y * t) →
          ∃ c : R,
            G * d * k = d * c ∧
              F * d * k = d * (-t * c) + (F + t * G) * d * k) := by
  constructor
  · exact support_union_of_finite_generators support d F G L W A H hcentral
  · intro k hk t ht
    exact common_colon_pencil_certificate d F G k t hk ht

end SymplecticStafford.Ordered

#print axioms SymplecticStafford.Ordered.support_union_of_finite_generators
#print axioms SymplecticStafford.Ordered.common_colon_pencil_certificate
#print axioms SymplecticStafford.Ordered.support_union_with_common_colon_certificates
