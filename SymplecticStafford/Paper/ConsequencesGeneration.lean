module

public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.Algebra.Module.Opposite
public import Mathlib.RingTheory.Noetherian.Defs
public import Mathlib.RingTheory.Finiteness.Defs
public import Mathlib.Algebra.BigOperators.Ring.Finset

@[expose] public section

/-!
# Module-theoretic consequences of the same-divisor theorem (paper §7, part I)

Throughout, `Λ` is a domain and right modules are modules over `Λᵐᵒᵖ`; the
right action `x · λ` is written `op λ • x`.  Right ideals of `Λ` are
`Submodule Λᵐᵒᵖ Λ`, and `aΛ + bΛ` is `Submodule.span Λᵐᵒᵖ {a, b}`.

The same-divisor property (3.8) of the paper is `S38 Λ`:
for every `d ≠ 0` there are `F, r, s` with `1 = d r + F d s`.

* `two_torsion_eq_span_singleton` (Theorem 7.1): two torsion elements `x, y`
  of a right module generate the same submodule as `x + y (H t)` for a suitable
  `H`, for any prescribed tail `t ≠ 0`.
* `exists_span_eq_singleton_of_isRightTorsion`, `isCyclic_of_forall_isRightTorsion`
  (Corollary to 7.1): finitely generated torsion right modules are cyclic.
* `span_triple_eq_span_pair` ((7.3)): `aΛ + bΛ + cΛ = aΛ + (b + c H t)Λ` for `a ≠ 0`.
* `exists_eq_span_pair` (Corollary 7.2): in a right Noetherian domain every right
  ideal is generated by any of its nonzero elements and one further element.
* `triple_prescribed_tails` (Theorem 7.3): `aΛ + bΛ + cΛ = (a + c f t₁)Λ + (b + c g t₂)Λ`.
* `stable_range_two` (Theorem 7.6): right stable range at most two.
* `two_source_identity` (Lemma 7.8): `1 = f₁ d₁ u₁ + f₂ d₂ u₂`.
* `exists_sup_span_singleton_eq_top` (fraction-free core of Theorem 7.4): a
  finitely generated module is `P + zΛ` whenever `M ⧸ P` is torsion.
* `stable_range_finset`: the stable-range reduction for unimodular rows of any
  length `≥ 3` (from Theorem 7.6 by induction on the length).
* `exists_comp_eq_proj` (unimodular-row completion): a surjective functional
  `Λⁱ → Λ` with `|ι| ≥ 3` is a coordinate projection after an automorphism.
* `stably_free_cancel_one`, `stably_free_is_free` (Corollary 7.7): if
  `M ⊕ Λᵐ ≅ Λⁿ` with `n ≥ m + 2` then `M ≅ Λⁿ⁻ᵐ`.
* `residual_splitting` (Lemma 7.10): from `x₁, x₂, φ₁, φ₂` as in Lemma 7.9, an
  element `x ∈ M` and `ψ` with `ψ x = 1`, `N = xΛ ⊕ ker ψ`, `M = xΛ ⊕ (M ∩ ker ψ)`.

The division ring of fractions (rank, Lemma 7.9, Theorems 7.12–7.13) is not used.
-/

namespace SymplecticStafford.Paper

open MulOpposite Submodule

/-- The same-divisor property (3.8): every nonzero `d` admits `F, r, s` with
`1 = d r + F d s`. -/
def S38 (Λ : Type*) [Ring Λ] : Prop :=
  ∀ d : Λ, d ≠ 0 → ∃ F r s : Λ, 1 = d * r + F * d * s

/-- The right Ore condition: nonzero `a, b` have a nonzero common right multiple
`a u = b v ≠ 0`. -/
def RightOre (Λ : Type*) [Ring Λ] : Prop :=
  ∀ a b : Λ, a ≠ 0 → b ≠ 0 → ∃ u v : Λ, a * u = b * v ∧ a * u ≠ 0

/-- The left Ore condition: nonzero `a, b` have a nonzero common left multiple
`u a = v b ≠ 0`. -/
def LeftOre (Λ : Type*) [Ring Λ] : Prop :=
  ∀ a b : Λ, a ≠ 0 → b ≠ 0 → ∃ u v : Λ, u * a = v * b ∧ u * a ≠ 0

variable {Λ : Type*} [Ring Λ]

section Torsion

variable {M : Type*} [AddCommGroup M] [Module Λᵐᵒᵖ M]

/-- An element `x` of a right module is torsion if `x c = 0` for some `c ≠ 0`. -/
def IsRightTorsion (Λ : Type*) [Ring Λ] {M : Type*} [AddCommGroup M] [Module Λᵐᵒᵖ M] (x : M) :
    Prop :=
  ∃ c : Λ, c ≠ 0 ∧ op c • x = 0

omit [AddCommGroup M] in
theorem op_mul_smul' {M : Type*} [AddCommMonoid M] [Module Λᵐᵒᵖ M] (a b : Λ) (x : M) :
    op (a * b) • x = op b • op a • x := by
  rw [op_mul, mul_smul]

theorem isRightTorsion_zero [Nontrivial Λ] : IsRightTorsion Λ (0 : M) :=
  ⟨1, one_ne_zero, smul_zero _⟩

theorem IsRightTorsion.add [IsDomain Λ] (hO : RightOre Λ) {x y : M}
    (hx : IsRightTorsion Λ x) (hy : IsRightTorsion Λ y) : IsRightTorsion Λ (x + y) := by
  obtain ⟨a, ha, hxa⟩ := hx
  obtain ⟨b, hb, hyb⟩ := hy
  obtain ⟨u, v, huv, hne⟩ := hO a b ha hb
  refine ⟨a * u, hne, ?_⟩
  rw [smul_add, op_mul_smul', hxa, smul_zero, zero_add, huv, op_mul_smul', hyb, smul_zero]

theorem IsRightTorsion.smul [IsDomain Λ] (hO : RightOre Λ) {x : M}
    (hx : IsRightTorsion Λ x) (r : Λ) : IsRightTorsion Λ (op r • x) := by
  by_cases hr : r = 0
  · subst hr
    rw [op_zero, zero_smul]
    exact isRightTorsion_zero
  obtain ⟨b, hb, hxb⟩ := hx
  obtain ⟨u, v, huv, hne⟩ := hO r b hr hb
  refine ⟨u, fun hu => hne (by rw [hu, mul_zero]), ?_⟩
  rw [← op_mul_smul', huv, op_mul_smul', hxb, smul_zero]

/-- Elements of the span of torsion elements are torsion. -/
theorem isRightTorsion_of_mem_span [IsDomain Λ] (hO : RightOre Λ) {s : Set M}
    (hs : ∀ x ∈ s, IsRightTorsion Λ x) {z : M} (hz : z ∈ span Λᵐᵒᵖ s) : IsRightTorsion Λ z := by
  induction hz using Submodule.span_induction with
  | mem x hx => exact hs x hx
  | zero => exact isRightTorsion_zero
  | add x y _ _ hx hy => exact hx.add hO hy
  | smul a x _ hx =>
    have := hx.smul hO a.unop
    rwa [op_unop] at this

/-- The algebraic core of Theorem 7.1: if `x a = 0`, `y (t a) = 0` and
`1 = (t a) u + H (t a) v`, then `xΛ + yΛ = (x + y H t)Λ`. -/
theorem span_pair_eq_span_singleton_of_identity {x y : M} {a t H u v : Λ}
    (hxa : op a • x = 0) (hye : op (t * a) • y = 0)
    (h1 : 1 = t * a * u + H * (t * a) * v) :
    span Λᵐᵒᵖ {x, y} = span Λᵐᵒᵖ {x + op (H * t) • y} := by
  have h2 : op (H * (t * a) * v) • y = y := by
    have := congrArg (fun r : Λ => op r • y) h1
    simp only [op_one, one_smul, op_add, add_smul, op_mul_smul' (t * a) u y, hye, smul_zero,
      zero_add] at this
    exact this.symm
  have hzy : op (a * v) • (x + op (H * t) • y) = y := by
    rw [smul_add, op_mul_smul' a v x, hxa, smul_zero, zero_add, smul_smul, ← op_mul]
    have : H * t * (a * v) = H * (t * a) * v := by simp only [mul_assoc]
    rw [this, h2]
  apply le_antisymm
  · rw [span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    have hy : y ∈ span Λᵐᵒᵖ {x + op (H * t) • y} := by
      have := smul_mem (span Λᵐᵒᵖ {x + op (H * t) • y}) (op (a * v)) (mem_span_singleton_self _)
      rwa [hzy] at this
    refine ⟨?_, hy⟩
    rw [SetLike.mem_coe]
    convert sub_mem (mem_span_singleton_self _) (smul_mem _ (op (H * t)) hy) using 1
    abel
  · rw [span_le, Set.singleton_subset_iff]
    exact add_mem (subset_span (by simp)) (smul_mem _ _ (subset_span (by simp)))

/-- **Theorem 7.1 (two elements compressed to one).**  Let `Λ` be a right Ore
domain with the same-divisor property.  If `x, y` are torsion elements of a
right module and `t ≠ 0`, then there is `H` with `xΛ + yΛ = (x + y H t)Λ`. -/
theorem two_torsion_eq_span_singleton [IsDomain Λ] (hO : RightOre Λ) (hS : S38 Λ) {x y : M}
    (hx : IsRightTorsion Λ x) (hy : IsRightTorsion Λ y) {t : Λ} (ht : t ≠ 0) :
    ∃ H : Λ, span Λᵐᵒᵖ {x, y} = span Λᵐᵒᵖ {x + op (H * t) • y} := by
  obtain ⟨a₀, ha₀, hxa₀⟩ := hx
  obtain ⟨b₀, hb₀, hyb₀⟩ := hy
  obtain ⟨u₀, v₀, heq, hne⟩ := hO (t * a₀) b₀ (mul_ne_zero ht ha₀) hb₀
  have hxa : op (a₀ * u₀) • x = 0 := by rw [op_mul_smul', hxa₀, smul_zero]
  have he : t * (a₀ * u₀) ≠ 0 := by rwa [← mul_assoc]
  have hye : op (t * (a₀ * u₀)) • y = 0 := by
    rw [← mul_assoc, heq, op_mul_smul', hyb₀, smul_zero]
  obtain ⟨H, u, v, h1⟩ := hS (t * (a₀ * u₀)) he
  exact ⟨H, span_pair_eq_span_singleton_of_identity hxa hye h1⟩

/-- **Corollary to Theorem 7.1.**  A finite family of torsion elements of a right
module generates a cyclic submodule. -/
theorem exists_span_eq_singleton_of_isRightTorsion [IsDomain Λ] (hO : RightOre Λ)
    (hS : S38 Λ) (s : Finset M) (hs : ∀ x ∈ s, IsRightTorsion Λ x) :
    ∃ z : M, span Λᵐᵒᵖ (s : Set M) = span Λᵐᵒᵖ {z} := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | insert x s _ ih =>
    obtain ⟨z, hz⟩ := ih fun y hy => hs y (Finset.mem_insert_of_mem hy)
    have hzt : IsRightTorsion Λ z :=
      isRightTorsion_of_mem_span hO (fun y hy => hs y (Finset.mem_insert_of_mem hy))
        (hz ▸ mem_span_singleton_self z)
    obtain ⟨H, hH⟩ := two_torsion_eq_span_singleton hO hS (hs x (Finset.mem_insert_self x s))
      hzt one_ne_zero
    refine ⟨x + op (H * 1) • z, ?_⟩
    rw [Finset.coe_insert, span_insert, hz, ← span_insert, hH]

/-- **Corollary to Theorem 7.1.**  Over a right Ore domain with the same-divisor
property, a finitely generated right module all of whose elements are torsion is
cyclic. -/
theorem isCyclic_of_forall_isRightTorsion [IsDomain Λ] (hO : RightOre Λ) (hS : S38 Λ)
    [Module.Finite Λᵐᵒᵖ M] (hM : ∀ x : M, IsRightTorsion Λ x) :
    ∃ z : M, span Λᵐᵒᵖ {z} = ⊤ := by
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := Λᵐᵒᵖ) (M := M)
  obtain ⟨z, hz⟩ := exists_span_eq_singleton_of_isRightTorsion hO hS s (fun x _ => hM x)
  exact ⟨z, hz ▸ hs⟩

/-- **Theorem 7.4, fraction-free core (rank + 1 generation).**  Let `Λ` be a right
Ore domain with the same-divisor property, `M` a finitely generated right module
and `P ≤ M` a submodule with torsion cokernel (e.g. `P` spanned by `r` elements
whose images form a basis of `M ⊗ Q(Λ)`).  Then one further element suffices:
`M = P + zΛ` for some `z`. -/
theorem exists_sup_span_singleton_eq_top [IsDomain Λ] (hO : RightOre Λ) (hS : S38 Λ)
    [Module.Finite Λᵐᵒᵖ M] (P : Submodule Λᵐᵒᵖ M) (hP : ∀ q : M ⧸ P, IsRightTorsion Λ q) :
    ∃ z : M, P ⊔ span Λᵐᵒᵖ {z} = ⊤ := by
  obtain ⟨w, hw⟩ := isCyclic_of_forall_isRightTorsion hO hS hP
  obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective P w
  refine ⟨z, ?_⟩
  rw [← comap_map_mkQ, map_span, Set.image_singleton]
  exact (congrArg (comap P.mkQ) hw).trans (comap_top _)

end Torsion

section RightIdeals

/-- Modulo a nonzero principal right ideal `aΛ` of a right Ore domain, every
element is torsion. -/
theorem isRightTorsion_quotient [IsDomain Λ] (hO : RightOre Λ) {a : Λ} (ha : a ≠ 0)
    (q : Λ ⧸ span Λᵐᵒᵖ {a}) : IsRightTorsion Λ q := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  by_cases hx : x = 0
  · subst hx
    exact isRightTorsion_zero
  obtain ⟨u, v, huv, hne⟩ := hO a x ha hx
  refine ⟨v, fun hv => hne (by rw [huv, hv, mul_zero]), ?_⟩
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, op_smul_eq_mul, ← huv,
    ← op_smul_eq_mul]
  exact smul_mem _ _ (mem_span_singleton_self a)

/-- Spans containing `a` are pulled back from the quotient by `aΛ`. -/
theorem span_insert_eq_comap (a : Λ) (s : Set Λ) :
    span Λᵐᵒᵖ (insert a s) =
      (span Λᵐᵒᵖ ((span Λᵐᵒᵖ {a}).mkQ '' s)).comap (span Λᵐᵒᵖ {a}).mkQ := by
  rw [span_insert, ← comap_map_mkQ, map_span]

/-- **(7.3) of the paper.**  In a right Ore domain with the same-divisor property,
if `a ≠ 0` then for every `t ≠ 0` there is `H` with
`aΛ + bΛ + cΛ = aΛ + (b + c H t)Λ`. -/
theorem span_triple_eq_span_pair [IsDomain Λ] (hO : RightOre Λ) (hS : S38 Λ) {a : Λ}
    (ha : a ≠ 0) (b c : Λ) {t : Λ} (ht : t ≠ 0) :
    ∃ H : Λ, span Λᵐᵒᵖ {a, b, c} = span Λᵐᵒᵖ {a, b + c * H * t} := by
  obtain ⟨H, hH⟩ := two_torsion_eq_span_singleton hO hS
    (isRightTorsion_quotient hO ha ((span Λᵐᵒᵖ {a}).mkQ b))
    (isRightTorsion_quotient hO ha ((span Λᵐᵒᵖ {a}).mkQ c)) ht
  refine ⟨H, ?_⟩
  have hc : (span Λᵐᵒᵖ {a}).mkQ (c * H * t) = op (H * t) • (span Λᵐᵒᵖ {a}).mkQ c := by
    rw [← LinearMap.map_smul, op_smul_eq_mul, mul_assoc]
  rw [span_insert_eq_comap, span_insert_eq_comap, Set.image_pair, Set.image_singleton, hH,
    map_add, hc]

/-- Two right ideals `aΛ + (finite set)` collapse to `aΛ + bΛ`. -/
theorem exists_span_insert_eq_pair [IsDomain Λ] (hO : RightOre Λ) (hS : S38 Λ) {a : Λ}
    (ha : a ≠ 0) (T : Finset Λ) : ∃ b : Λ, span Λᵐᵒᵖ (insert a (T : Set Λ)) = span Λᵐᵒᵖ {a, b} := by
  classical
  induction T using Finset.induction_on with
  | empty =>
    refine ⟨0, ?_⟩
    rw [Finset.coe_empty, Set.pair_comm, span_insert_zero]
    congr 1
    ext
    simp
  | insert x T _ ih =>
    obtain ⟨b, hb⟩ := ih
    obtain ⟨H, hH⟩ := span_triple_eq_span_pair hO hS ha b x (one_ne_zero (α := Λ))
    refine ⟨b + x * H * 1, ?_⟩
    rw [← hH, Finset.coe_insert, Set.insert_comm, span_insert, hb]
    simp only [span_insert]
    ac_rfl

/-- **Corollary 7.2.**  In a right Noetherian right Ore domain with the
same-divisor property, every right ideal `I` containing `a ≠ 0` is
`I = aΛ + bΛ` for some `b ∈ I`. -/
theorem exists_eq_span_pair [IsDomain Λ] [IsNoetherian Λᵐᵒᵖ Λ] (hO : RightOre Λ) (hS : S38 Λ)
    (I : Submodule Λᵐᵒᵖ Λ) {a : Λ} (ha : a ≠ 0) (haI : a ∈ I) :
    ∃ b ∈ I, I = span Λᵐᵒᵖ {a, b} := by
  obtain ⟨T, hT⟩ := IsNoetherian.noetherian I
  obtain ⟨b, hb⟩ := exists_span_insert_eq_pair hO hS ha T
  have hI : span Λᵐᵒᵖ (insert a (T : Set Λ)) = I := by
    rw [span_insert, hT, sup_eq_right, span_singleton_le_iff_mem]
    exact haI
  rw [hI] at hb
  refine ⟨b, ?_, hb⟩
  rw [hb]
  exact subset_span (by simp)

/-- **Theorem 7.3 (full prescribed-tail triple).**  Let `Λ` be a left and right
Ore domain with the same-divisor property.  For all `a, b, c` and all
`t₁, t₂ ≠ 0` there are `f, g` with
`aΛ + bΛ + cΛ = (a + c f t₁)Λ + (b + c g t₂)Λ`. -/
theorem triple_prescribed_tails [IsDomain Λ] (hR : RightOre Λ) (hL : LeftOre Λ) (hS : S38 Λ)
    (a b c : Λ) {t₁ t₂ : Λ} (ht₁ : t₁ ≠ 0) (ht₂ : t₂ ≠ 0) :
    ∃ f g : Λ, span Λᵐᵒᵖ {a, b, c} = span Λᵐᵒᵖ {a + c * f * t₁, b + c * g * t₂} := by
  by_cases ha : a ≠ 0
  · obtain ⟨H, hH⟩ := span_triple_eq_span_pair hR hS ha b c ht₂
    exact ⟨0, H, by simpa using hH⟩
  push Not at ha
  subst ha
  by_cases hb : b ≠ 0
  · obtain ⟨H, hH⟩ := span_triple_eq_span_pair hR hS hb 0 c ht₁
    refine ⟨H, 0, ?_⟩
    rw [Set.insert_comm, hH, Set.pair_comm]
    simp
  push Not at hb
  subst hb
  by_cases hc : c ≠ 0
  · obtain ⟨u₁, u₂, hu, hne⟩ := hL t₁ t₂ ht₁ ht₂
    obtain ⟨H, r, s, h1⟩ := hS (u₁ * t₁) hne
    refine ⟨u₁, H * u₂, ?_⟩
    have e₁ : 0 + c * u₁ * t₁ = c * (u₁ * t₁) := by rw [zero_add, mul_assoc]
    have e₂ : 0 + c * (H * u₂) * t₂ = c * (H * (u₁ * t₁)) := by
      rw [zero_add, hu]
      simp only [mul_assoc]
    rw [e₁, e₂, span_insert_zero, span_insert_zero]
    apply le_antisymm
    · rw [span_le, Set.singleton_subset_iff]
      have : c = op r • (c * (u₁ * t₁)) + op s • (c * (H * (u₁ * t₁))) := by
        simp only [op_smul_eq_mul]
        calc c = c * 1 := (mul_one c).symm
          _ = _ := by
            rw [h1]
            simp only [mul_add, mul_assoc]
      have hmem : op r • (c * (u₁ * t₁)) + op s • (c * (H * (u₁ * t₁))) ∈
          span Λᵐᵒᵖ {c * (u₁ * t₁), c * (H * (u₁ * t₁))} :=
        add_mem (smul_mem _ _ (subset_span (by simp))) (smul_mem _ _ (subset_span (by simp)))
      rwa [← this] at hmem
    · rw [span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      refine ⟨?_, ?_⟩
      · rw [← op_smul_eq_mul]
        exact smul_mem _ _ (mem_span_singleton_self c)
      · rw [← op_smul_eq_mul]
        exact smul_mem _ _ (mem_span_singleton_self c)
  push Not at hc
  subst hc
  exact ⟨0, 0, by simp⟩

/-- **Theorem 7.6 (right stable range at most two).**  If `aΛ + bΛ + cΛ = Λ` then
there are `f, g` with `(a + c f)Λ + (b + c g)Λ = Λ`. -/
theorem stable_range_two [IsDomain Λ] (hR : RightOre Λ) (hL : LeftOre Λ) (hS : S38 Λ)
    {a b c : Λ} (h : span Λᵐᵒᵖ {a, b, c} = ⊤) :
    ∃ f g : Λ, span Λᵐᵒᵖ {a + c * f, b + c * g} = ⊤ := by
  obtain ⟨f, g, hfg⟩ := triple_prescribed_tails hR hL hS a b c one_ne_zero one_ne_zero
  exact ⟨f, g, by simpa [hfg] using h⟩

/-- **Lemma 7.8 (two-source identity).**  In a right Ore domain with the
same-divisor property, for `d₁, d₂ ≠ 0` there are `f₁, f₂, u₁, u₂` with
`1 = f₁ d₁ u₁ + f₂ d₂ u₂`. -/
theorem two_source_identity [IsDomain Λ] (hR : RightOre Λ) (hS : S38 Λ) {d₁ d₂ : Λ}
    (hd₁ : d₁ ≠ 0) (hd₂ : d₂ ≠ 0) :
    ∃ f₁ f₂ u₁ u₂ : Λ, 1 = f₁ * d₁ * u₁ + f₂ * d₂ * u₂ := by
  obtain ⟨p, q, hpq, hne⟩ := hR d₁ d₂ hd₁ hd₂
  obtain ⟨F, r, s, h1⟩ := hS (d₁ * p) hne
  refine ⟨1, F, p * r, q * s, ?_⟩
  have e : F * d₂ * (q * s) = F * (d₁ * p) * s := by
    rw [hpq]
    simp only [mul_assoc]
  rw [e, one_mul, ← mul_assoc]
  exact h1

end RightIdeals

section StablyFree

theorem eq_top_of_one_mem' {I : Submodule Λᵐᵒᵖ Λ} (h : (1 : Λ) ∈ I) : I = ⊤ :=
  eq_top_iff.2 fun x _ => by simpa using I.smul_mem (op x) h

/-- **Right stable range for rows of arbitrary length.**  If `φ` is unimodular on
a finite set `s` with at least three elements (`∑_{i ∈ s} φ i Λ = Λ`), then any
prescribed entry `φ j` (`j ∈ s`) can be absorbed: there is `g` with
`∑_{i ∈ s, i ≠ j} (φ i + φ j g i) Λ = Λ`.  This extends Theorem 7.6 from length
three to every length by the usual induction on the length. -/
theorem stable_range_finset [IsDomain Λ] (hR : RightOre Λ) (hL : LeftOre Λ) (hS : S38 Λ)
    {ι : Type*} [DecidableEq ι] (n : ℕ) :
    ∀ (φ : ι → Λ) (s : Finset ι), s.card = n + 3 → span Λᵐᵒᵖ (φ '' (s : Set ι)) = ⊤ →
      ∀ j ∈ s, ∃ g : ι → Λ,
        span Λᵐᵒᵖ ((fun i => φ i + φ j * g i) '' ((s.erase j : Finset ι) : Set ι)) = ⊤ := by
  induction n with
  | zero =>
    intro φ s hs hφ j hj
    have h2 : (s.erase j).card = 2 := by rw [Finset.card_erase_of_mem hj, hs]
    obtain ⟨p, q, hpq, hpq'⟩ := Finset.card_eq_two.1 h2
    have hs' : s = insert j {p, q} := by rw [← hpq', Finset.insert_erase hj]
    rw [hs', Finset.coe_insert, Finset.coe_pair, Set.image_insert_eq, Set.image_pair,
      Set.insert_comm (φ j) (φ p), Set.pair_comm (φ j) (φ q)] at hφ
    obtain ⟨f, g, hfg⟩ := stable_range_two hR hL hS hφ
    refine ⟨fun i => if i = p then f else g, ?_⟩
    rw [hpq', Finset.coe_pair, Set.image_pair]
    simp only [if_neg hpq.symm]
    exact hfg
  | succ n ih =>
    intro φ s hs hφ j hj
    have hne : (s.erase j).Nonempty := by
      rw [← Finset.card_pos, Finset.card_erase_of_mem hj, hs]
      omega
    obtain ⟨j', hj'⟩ := hne
    have hj'j : j' ≠ j := Finset.ne_of_mem_erase hj'
    have hj's : j' ∈ s := Finset.mem_of_mem_erase hj'
    have h1 : (1 : Λ) ∈ span Λᵐᵒᵖ {φ j, φ j'} ⊔
        span Λᵐᵒᵖ (φ '' (((s.erase j).erase j' : Finset ι) : Set ι)) := by
      rw [← span_union]
      have h1s : (1 : Λ) ∈ span Λᵐᵒᵖ (φ '' (s : Set ι)) := by rw [hφ]; exact mem_top
      refine span_mono ?_ h1s
      rintro _ ⟨i, hi, rfl⟩
      by_cases hij : i = j
      · subst hij
        exact Or.inl (by simp)
      by_cases hij' : i = j'
      · subst hij'
        exact Or.inl (by simp)
      exact Or.inr ⟨i, by simp [hij, hij', Finset.mem_coe.1 hi], rfl⟩
    obtain ⟨w, hw, z, hz, hwz⟩ := mem_sup.1 h1
    obtain ⟨bj, bj', hb⟩ := mem_span_pair.1 hw
    obtain ⟨φ', hφ'j', hφ'ne⟩ : ∃ φ' : ι → Λ, φ' j' = w ∧ ∀ i, i ≠ j' → φ' i = φ i :=
      ⟨Function.update φ j' w, by simp, fun i hi => by simp [hi]⟩
    have hφ' : span Λᵐᵒᵖ (φ' '' ((s.erase j : Finset ι) : Set ι)) = ⊤ := by
      refine eq_top_of_one_mem' ?_
      rw [← hwz]
      refine add_mem (subset_span ⟨j', hj', hφ'j'⟩) (span_mono ?_ hz)
      rintro _ ⟨i, hi, rfl⟩
      have hi' := Finset.mem_coe.1 hi
      exact ⟨i, Finset.mem_of_mem_erase hi', hφ'ne i (Finset.ne_of_mem_erase hi')⟩
    obtain ⟨g', hg'⟩ := ih φ' (s.erase j)
      (by rw [Finset.card_erase_of_mem hj, hs]; omega) hφ' j' hj'
    refine ⟨fun i => if i = j' then 0 else MulOpposite.unop bj * g' i, eq_top_of_one_mem' ?_⟩
    have hle : span Λᵐᵒᵖ ((fun i => φ' i + φ' j' * g' i) ''
        (((s.erase j).erase j' : Finset ι) : Set ι)) ≤
        span Λᵐᵒᵖ ((fun i => φ i + φ j * (if i = j' then 0 else MulOpposite.unop bj * g' i)) ''
          ((s.erase j : Finset ι) : Set ι)) := by
      rw [span_le]
      rintro _ ⟨i, hi, rfl⟩
      have hi' := Finset.mem_coe.1 hi
      have hi1 : i ≠ j' := Finset.ne_of_mem_erase hi'
      have hi2 : i ∈ s.erase j := Finset.mem_of_mem_erase hi'
      have hmem : φ i + φ j * (if i = j' then 0 else MulOpposite.unop bj * g' i) ∈
          span Λᵐᵒᵖ ((fun i => φ i + φ j * (if i = j' then 0 else MulOpposite.unop bj * g' i)) ''
            ((s.erase j : Finset ι) : Set ι)) := subset_span ⟨i, hi2, rfl⟩
      have hj'mem : φ j' ∈
          span Λᵐᵒᵖ ((fun i => φ i + φ j * (if i = j' then 0 else MulOpposite.unop bj * g' i)) ''
            ((s.erase j : Finset ι) : Set ι)) := subset_span ⟨j', hj', by simp⟩
      have heq : φ' i + φ' j' * g' i =
          (φ i + φ j * (if i = j' then 0 else MulOpposite.unop bj * g' i)) +
            op (MulOpposite.unop bj' * g' i) • φ j' := by
        rw [hφ'ne i hi1, hφ'j', ← hb, if_neg hi1]
        simp only [MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]
        rw [add_mul, add_assoc]
        simp only [mul_assoc]
      show φ' i + φ' j' * g' i ∈ _
      rw [heq]
      exact add_mem hmem (smul_mem _ _ hj'mem)
    apply hle
    rw [hg']
    exact mem_top

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

omit [Fintype ι] in
theorem pi_single_eq_op_smul (i : ι) (c : Λ) :
    (Pi.single i c : ι → Λ) = op c • (Pi.single i 1 : ι → Λ) := by
  ext l
  by_cases h : l = i
  · subst h
    simp
  · simp [h]

/-- A right-linear functional on `Λⁱ` is given by its row `ψ(eᵢ)`:
`ψ x = ∑ ψ(eᵢ) xᵢ`. -/
theorem linearMap_apply_eq_sum (ψ : (ι → Λ) →ₗ[Λᵐᵒᵖ] Λ) (x : ι → Λ) :
    ψ x = ∑ i, ψ (Pi.single i 1) * x i := by
  conv_lhs => rw [← Finset.univ_sum_single x]
  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [pi_single_eq_op_smul, map_smul]
  simp only [MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]

/-- The right-linear functional with row `φ`. -/
def rowForm (φ : ι → Λ) : (ι → Λ) →ₗ[Λᵐᵒᵖ] Λ where
  toFun x := ∑ i, φ i * x i
  map_add' x y := by simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
  map_smul' a x := by
    simp only [Pi.smul_apply, MulOpposite.smul_eq_mul_unop, RingHom.id_apply, Finset.sum_mul,
      mul_assoc]

theorem rowForm_single (φ : ι → Λ) (j : ι) (c : Λ) : rowForm φ (Pi.single j c) = φ j * c := by
  simp [rowForm, Pi.single_apply]

/-- `1 + A` is an automorphism when `A² = 0`. -/
def shear {V : Type*} [AddCommGroup V] [Module Λᵐᵒᵖ V] (A : V →ₗ[Λᵐᵒᵖ] V)
    (hA : ∀ x, A (A x) = 0) : V ≃ₗ[Λᵐᵒᵖ] V :=
  LinearEquiv.ofLinearMap (LinearMap.id + A) (LinearMap.id - A)
    (LinearMap.ext fun x => by simp [hA]) (LinearMap.ext fun x => by simp [hA])

theorem shear_apply {V : Type*} [AddCommGroup V] [Module Λᵐᵒᵖ V] (A : V →ₗ[Λᵐᵒᵖ] V)
    (hA : ∀ x, A (A x) = 0) (x : V) : shear A hA x = x + A x := rfl

/-- The column operation adding `eⱼ (∑ φᵢ xᵢ)`. -/
def colShearMap (j : ι) (φ : ι → Λ) : (ι → Λ) →ₗ[Λᵐᵒᵖ] (ι → Λ) :=
  (LinearMap.single Λᵐᵒᵖ (fun _ : ι => Λ) j).comp (rowForm φ)

theorem colShearMap_sq {j : ι} {φ : ι → Λ} (hφ : φ j = 0) (x : ι → Λ) :
    colShearMap j φ (colShearMap j φ x) = 0 := by
  simp [colShearMap, rowForm_single, hφ]

/-- The operation adding `v · x_k`. -/
def rowShearMap (k : ι) (v : ι → Λ) : (ι → Λ) →ₗ[Λᵐᵒᵖ] (ι → Λ) where
  toFun x := op (x k) • v
  map_add' x y := by simp only [Pi.add_apply, op_add, add_smul]
  map_smul' a x := by
    simp only [Pi.smul_apply, RingHom.id_apply, smul_smul, MulOpposite.smul_eq_mul_unop, op_mul,
      op_unop]

omit [Fintype ι] [DecidableEq ι] in
theorem rowShearMap_sq {k : ι} {v : ι → Λ} (hv : v k = 0) (x : ι → Λ) :
    rowShearMap k v (rowShearMap k v x) = 0 := by
  simp [rowShearMap, hv]

/-- Elementary column operation on the row of a functional:
`ψ(eᵢ) ↦ ψ(eᵢ) + ψ(eⱼ) gᵢ` for `i ≠ j`. -/
theorem exists_col_step (ψ : (ι → Λ) →ₗ[Λᵐᵒᵖ] Λ) (j : ι) (g : ι → Λ) :
    ∃ E : (ι → Λ) ≃ₗ[Λᵐᵒᵖ] (ι → Λ), ∀ i, (ψ.comp E.toLinearMap) (Pi.single i 1) =
      ψ (Pi.single i 1) + ψ (Pi.single j 1) * (if i = j then 0 else g i) := by
  have hg : (fun i => if i = j then 0 else g i) j = 0 := by simp
  refine ⟨shear (colShearMap j (fun i => if i = j then 0 else g i)) (colShearMap_sq hg), fun i => ?_⟩
  rw [LinearMap.comp_apply, LinearEquiv.coe_coe, shear_apply, map_add, colShearMap,
    LinearMap.comp_apply, rowForm_single, LinearMap.single_apply, mul_one,
    pi_single_eq_op_smul j, map_smul]
  simp only [MulOpposite.smul_eq_mul_unop, MulOpposite.unop_op]

omit [Fintype ι] in
/-- Elementary operation `ψ(eₖ) ↦ ψ(eₖ) + ψ(v)` for `v` with `vₖ = 0`. -/
theorem exists_row_step (ψ : (ι → Λ) →ₗ[Λᵐᵒᵖ] Λ) (k : ι) (v : ι → Λ) (hv : v k = 0) :
    ∃ E : (ι → Λ) ≃ₗ[Λᵐᵒᵖ] (ι → Λ),
      (ψ.comp E.toLinearMap) (Pi.single k 1) = ψ (Pi.single k 1) + ψ v := by
  refine ⟨shear (rowShearMap k v) (rowShearMap_sq hv), ?_⟩
  rw [LinearMap.comp_apply, LinearEquiv.coe_coe, shear_apply, map_add]
  simp [rowShearMap]

/-- **Unimodular-row completion.**  Let `Λ` be a left and right Ore domain with the
same-divisor property and let `ι` have at least three elements.  Every surjective
right-linear functional `ψ : Λⁱ → Λ` (a unimodular row) becomes a coordinate
projection after an automorphism of `Λⁱ`: the row is part of a basis. -/
theorem exists_comp_eq_proj [IsDomain Λ] (hR : RightOre Λ) (hL : LeftOre Λ) (hS : S38 Λ)
    (hι : 3 ≤ Fintype.card ι) (ψ : (ι → Λ) →ₗ[Λᵐᵒᵖ] Λ) (hψ : Function.Surjective ψ) :
    ∃ (j : ι) (E : (ι → Λ) ≃ₗ[Λᵐᵒᵖ] (ι → Λ)),
      ψ.comp E.toLinearMap = LinearMap.proj (R := Λᵐᵒᵖ) (φ := fun _ : ι => Λ) j := by
  obtain ⟨j⟩ : Nonempty ι := Fintype.card_pos_iff.1 (by omega)
  have hφ : span Λᵐᵒᵖ ((fun i => ψ (Pi.single i 1)) '' ((Finset.univ : Finset ι) : Set ι)) =
      ⊤ := by
    refine eq_top_iff.2 fun y _ => ?_
    obtain ⟨x, rfl⟩ := hψ y
    rw [linearMap_apply_eq_sum]
    refine sum_mem fun i _ => ?_
    have : ψ (Pi.single i 1) * x i = op (x i) • ψ (Pi.single i 1) := rfl
    rw [this]
    exact smul_mem _ _ (subset_span ⟨i, by simp, rfl⟩)
  obtain ⟨g, hg⟩ := stable_range_finset hR hL hS (Fintype.card ι - 3) _ Finset.univ
    (by rw [Finset.card_univ]; omega) hφ j (Finset.mem_univ j)
  -- first step: make the entries off `j` unimodular
  obtain ⟨E₁, hE₁⟩ := exists_col_step ψ j g
  have hE₁j : (ψ.comp E₁.toLinearMap) (Pi.single j 1) = ψ (Pi.single j 1) := by
    rw [hE₁]; simp
  have hspan : span Λᵐᵒᵖ ((fun i => (ψ.comp E₁.toLinearMap) (Pi.single i 1)) ''
      ((Finset.univ.erase j : Finset ι) : Set ι)) = ⊤ := by
    rw [← hg]
    congr 1
    refine Set.image_congr fun i hi => ?_
    rw [hE₁, if_neg (Finset.ne_of_mem_erase (Finset.mem_coe.1 hi))]
  -- second step: make the `j`-entry equal to `1`
  obtain ⟨v, hvj, hv⟩ : ∃ v : ι → Λ, v j = 0 ∧
      (ψ.comp E₁.toLinearMap) v = 1 - (ψ.comp E₁.toLinearMap) (Pi.single j 1) := by
    have hle : span Λᵐᵒᵖ ((fun i => (ψ.comp E₁.toLinearMap) (Pi.single i 1)) ''
        ((Finset.univ.erase j : Finset ι) : Set ι)) ≤
        (LinearMap.ker (LinearMap.proj (R := Λᵐᵒᵖ) (φ := fun _ : ι => Λ) j)).map
          (ψ.comp E₁.toLinearMap) := by
      rw [span_le]
      rintro _ ⟨i, hi, rfl⟩
      refine ⟨Pi.single i 1, ?_, rfl⟩
      have : j ≠ i := (Finset.ne_of_mem_erase (Finset.mem_coe.1 hi)).symm
      simp [this]
    have h1 : 1 - (ψ.comp E₁.toLinearMap) (Pi.single j 1) ∈ span Λᵐᵒᵖ
        ((fun i => (ψ.comp E₁.toLinearMap) (Pi.single i 1)) ''
          ((Finset.univ.erase j : Finset ι) : Set ι)) := by
      rw [hspan]; exact mem_top
    obtain ⟨v, hv, hv'⟩ := hle h1
    exact ⟨v, by simpa using hv, hv'⟩
  obtain ⟨E₂, hE₂⟩ := exists_row_step (ψ.comp E₁.toLinearMap) j v hvj
  rw [hv, add_sub_cancel] at hE₂
  -- third step: clear the other entries
  obtain ⟨E₃, hE₃⟩ := exists_col_step ((ψ.comp E₁.toLinearMap).comp E₂.toLinearMap) j
    (fun i => -((ψ.comp E₁.toLinearMap).comp E₂.toLinearMap) (Pi.single i 1))
  refine ⟨j, (E₃.trans E₂).trans E₁, ?_⟩
  have hc : ψ.comp ((E₃.trans E₂).trans E₁).toLinearMap =
      ((ψ.comp E₁.toLinearMap).comp E₂.toLinearMap).comp E₃.toLinearMap := rfl
  rw [hc]
  refine LinearMap.ext fun x => ?_
  rw [linearMap_apply_eq_sum, Finset.sum_eq_single j]
  · rw [hE₃, hE₂]
    simp
  · intro i _ hij
    rw [hE₃, hE₂, if_neg hij]
    simp
  · simp

/-- The kernel of the `j`-th coordinate projection is free on the other coordinates. -/
def kerProjEquiv (j : ι) :
    LinearMap.ker (LinearMap.proj (R := Λᵐᵒᵖ) (φ := fun _ : ι => Λ) j) ≃ₗ[Λᵐᵒᵖ]
      ({i // i ≠ j} → Λ) where
  toFun x i := (x : ι → Λ) i
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  invFun y := ⟨fun i => if h : i = j then 0 else y ⟨i, h⟩, by simp⟩
  left_inv x := by
    refine Subtype.ext (funext fun i => ?_)
    by_cases h : i = j
    · subst h
      have := LinearMap.mem_ker.1 x.2
      simp only [LinearMap.proj_apply] at this
      simp [this]
    · simp [h]
  right_inv y := by
    funext i
    simp [i.2]

/-- **Corollary 7.7, one step.**  Over a left and right Ore domain with the
same-divisor property, if `M ⊕ Λ ≅ Λⁱ` with `|ι| ≥ 3`, then `M` is free on
`|ι| - 1` generators. -/
theorem stably_free_cancel_one [IsDomain Λ] (hR : RightOre Λ) (hL : LeftOre Λ) (hS : S38 Λ)
    (hι : 3 ≤ Fintype.card ι) {M : Type*} [AddCommGroup M] [Module Λᵐᵒᵖ M]
    (e : (M × Λ) ≃ₗ[Λᵐᵒᵖ] (ι → Λ)) :
    ∃ j : ι, Nonempty (M ≃ₗ[Λᵐᵒᵖ] ({i // i ≠ j} → Λ)) := by
  let ψ : (ι → Λ) →ₗ[Λᵐᵒᵖ] Λ := (LinearMap.snd Λᵐᵒᵖ M Λ).comp e.symm.toLinearMap
  have hψ : Function.Surjective ψ := fun y => ⟨e (0, y), by simp [ψ]⟩
  obtain ⟨j, E, hE⟩ := exists_comp_eq_proj hR hL hS hι ψ hψ
  have hinj : Function.Injective (e.toLinearMap.comp (LinearMap.inl Λᵐᵒᵖ M Λ)) :=
    fun m m' h => by simpa using e.injective h
  have hrange : LinearMap.range (e.toLinearMap.comp (LinearMap.inl Λᵐᵒᵖ M Λ)) =
      LinearMap.ker ψ := by
    ext v
    rw [LinearMap.mem_range, LinearMap.mem_ker]
    constructor
    · rintro ⟨m, rfl⟩
      simp [ψ]
    · intro hv
      refine ⟨(e.symm v).1, e.symm.injective ?_⟩
      rw [LinearMap.comp_apply, LinearEquiv.coe_coe, e.symm_apply_apply]
      exact Prod.ext rfl hv.symm
  have hker : (LinearMap.ker ψ).map (E.symm : (ι → Λ) →ₗ[Λᵐᵒᵖ] (ι → Λ)) =
      LinearMap.ker (LinearMap.proj (R := Λᵐᵒᵖ) (φ := fun _ : ι => Λ) j) := by
    rw [← hE]
    ext x
    simp
  exact ⟨j, ⟨((LinearEquiv.ofInjective _ hinj).trans (LinearEquiv.ofEq _ _ hrange)).trans
    ((E.symm.ofSubmodules _ _ hker).trans (kerProjEquiv j))⟩⟩

/-- **Corollary 7.7 (stably free modules of rank at least two are free).**  Over a
left and right Ore domain with the same-divisor property, if
`M ⊕ Λᵐ ≅ Λⁿ` with `n ≥ m + 2`, then `M ≅ Λⁿ⁻ᵐ`. -/
theorem stably_free_is_free [IsDomain Λ] (hR : RightOre Λ) (hL : LeftOre Λ) (hS : S38 Λ)
    {M : Type*} [AddCommGroup M] [Module Λᵐᵒᵖ M] (m : ℕ) :
    ∀ n : ℕ, m + 2 ≤ n → ((M × (Fin m → Λ)) ≃ₗ[Λᵐᵒᵖ] (Fin n → Λ)) →
      Nonempty (M ≃ₗ[Λᵐᵒᵖ] (Fin (n - m) → Λ)) := by
  induction m with
  | zero =>
    intro n _ e
    exact ⟨LinearEquiv.prodUnique.symm.trans e⟩
  | succ m ih =>
    intro n hn e
    let e' : ((M × (Fin m → Λ)) × Λ) ≃ₗ[Λᵐᵒᵖ] (Fin n → Λ) :=
      (LinearEquiv.prodAssoc Λᵐᵒᵖ M (Fin m → Λ) Λ).trans
        ((LinearEquiv.prodCongr (LinearEquiv.refl Λᵐᵒᵖ M)
          ((LinearEquiv.prodComm Λᵐᵒᵖ (Fin m → Λ) Λ).trans
            (Fin.consLinearEquiv Λᵐᵒᵖ (fun _ : Fin (m + 1) => Λ)))).trans e)
    obtain ⟨j, ⟨f⟩⟩ := stably_free_cancel_one hR hL hS (by simp; omega) e'
    have hcard : Fintype.card {i // i ≠ j} = n - 1 := by
      simp [Fintype.card_subtype_compl]
    let f' : (M × (Fin m → Λ)) ≃ₗ[Λᵐᵒᵖ] (Fin (n - 1) → Λ) :=
      f.trans (LinearEquiv.funCongrLeft Λᵐᵒᵖ Λ (Fintype.equivFinOfCardEq hcard).symm)
    obtain ⟨g⟩ := ih (n - 1) (by omega) f'
    have : n - 1 - m = n - (m + 1) := by omega
    rw [this] at g
    exact ⟨g⟩

end StablyFree

section ResidualSplitting

variable {N : Type*} [AddCommGroup N] [Module Λᵐᵒᵖ N]

/-- Left multiplication by `f` is right-linear. -/
def lmulLeft (f : Λ) : Λ →ₗ[Λᵐᵒᵖ] Λ where
  toFun y := f * y
  map_add' x y := mul_add f x y
  map_smul' a y := by
    simp only [MulOpposite.smul_eq_mul_unop, RingHom.id_apply, mul_assoc]

theorem lmulLeft_apply (f y : Λ) : lmulLeft f y = f * y := rfl

/-- **Lemma 7.10 (rank-one residual splitting).**  Let `Λ` be a right Ore domain
with the same-divisor property, `M ≤ N` right modules, `x₁, x₂ ∈ M` and
`φ₁, φ₂ : N → Λ` right-linear with `φ₁ x₂ = 0 = φ₂ x₁` and `d₁ = φ₁ x₁ ≠ 0`,
`d₂ = φ₂ x₂ ≠ 0`.  Then with `1 = f₁ d₁ u₁ + f₂ d₂ u₂` (Lemma 7.8),
`x = x₁ u₁ + x₂ u₂ ∈ M` and `ψ = f₁ φ₁ + f₂ φ₂` satisfy `ψ x = 1`; hence
`N = xΛ ⊕ ker ψ` and `M = xΛ ⊕ (M ∩ ker ψ)`. -/
theorem residual_splitting [IsDomain Λ] (hR : RightOre Λ) (hS : S38 Λ)
    (M : Submodule Λᵐᵒᵖ N) {x₁ x₂ : N} (hx₁ : x₁ ∈ M) (hx₂ : x₂ ∈ M)
    (φ₁ φ₂ : N →ₗ[Λᵐᵒᵖ] Λ) (h₁₂ : φ₁ x₂ = 0) (h₂₁ : φ₂ x₁ = 0)
    (hd₁ : φ₁ x₁ ≠ 0) (hd₂ : φ₂ x₂ ≠ 0) :
    ∃ x ∈ M, ∃ ψ : N →ₗ[Λᵐᵒᵖ] Λ, ψ x = 1 ∧
      IsCompl (span Λᵐᵒᵖ {x}) (LinearMap.ker ψ) ∧
      span Λᵐᵒᵖ {x} ⊔ (M ⊓ LinearMap.ker ψ) = M ∧
      span Λᵐᵒᵖ {x} ⊓ (M ⊓ LinearMap.ker ψ) = ⊥ := by
  obtain ⟨f₁, f₂, u₁, u₂, h1⟩ := two_source_identity hR hS hd₁ hd₂
  set x := op u₁ • x₁ + op u₂ • x₂ with hxdef
  set ψ := (lmulLeft f₁).comp φ₁ + (lmulLeft f₂).comp φ₂ with hψdef
  have hψx : ψ x = 1 := by
    simp only [hψdef, hxdef, LinearMap.add_apply, LinearMap.comp_apply, lmulLeft_apply, map_add,
      map_smul, h₁₂, h₂₁, MulOpposite.smul_eq_mul_unop,
      MulOpposite.unop_op]
    rw [h1]
    simp only [mul_zero, add_zero, zero_add, mul_assoc]
  have hxM : x ∈ M := add_mem (M.smul_mem _ hx₁) (M.smul_mem _ hx₂)
  -- the projection onto `ker ψ`
  have hdec : ∀ n : N, n - op (ψ n) • x ∈ LinearMap.ker ψ := by
    intro n
    rw [LinearMap.mem_ker, map_sub, map_smul, hψx, MulOpposite.smul_eq_mul_unop,
      MulOpposite.unop_op, one_mul, sub_self]
  have hdisj : span Λᵐᵒᵖ {x} ⊓ LinearMap.ker ψ = ⊥ := by
    rw [eq_bot_iff]
    rintro n ⟨hn, hn'⟩
    obtain ⟨a, rfl⟩ := mem_span_singleton.1 hn
    rw [SetLike.mem_coe, LinearMap.mem_ker, map_smul, hψx, MulOpposite.smul_eq_mul_unop,
      one_mul] at hn'
    rw [mem_bot, ← MulOpposite.op_unop a, hn', op_zero, zero_smul]
  have hsum : ∀ n : N, n ∈ span Λᵐᵒᵖ {x} ⊔ LinearMap.ker ψ := by
    intro n
    have : n = op (ψ n) • x + (n - op (ψ n) • x) := by abel
    rw [this]
    exact add_mem_sup (smul_mem _ _ (mem_span_singleton_self x)) (hdec n)
  refine ⟨x, hxM, ψ, hψx, ⟨?_, ?_⟩, ?_, ?_⟩
  · rw [disjoint_iff]; exact hdisj
  · rw [codisjoint_iff, eq_top_iff]; exact fun n _ => hsum n
  · apply le_antisymm
    · exact sup_le ((span_singleton_le_iff_mem _ _).2 hxM) inf_le_left
    · intro n hn
      have : n = op (ψ n) • x + (n - op (ψ n) • x) := by abel
      rw [this]
      exact add_mem_sup (smul_mem _ _ (mem_span_singleton_self x))
        ⟨sub_mem hn (M.smul_mem _ hxM), hdec n⟩
  · rw [eq_bot_iff]
    exact le_trans (inf_le_inf_left _ inf_le_right) hdisj.le

end ResidualSplitting

end SymplecticStafford.Paper
