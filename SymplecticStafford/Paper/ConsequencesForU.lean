import SymplecticStafford.Paper.Opposite
import SymplecticStafford.Paper.ConsequencesRank

/-!
# Module-theoretic consequences for the filtered class (paper §7 applied to `U`)

Target theorem A gives the same-divisor property `S38` for `U`, and applied to
the opposite algebra (§7.7) it gives `S38` for `Uᵐᵒᵖ`.  Together with the Ore
conditions (Z1 at the zero prime, in `U` and in `Uᵐᵒᵖ`) this makes every
consequence of §7 unconditional for the standing filtered class:

* every finitely generated torsion right `U`-module is cyclic (7.1);
* every right ideal is generated by any nonzero element and one more (7.2);
* right stable range at most two (7.6);
* stably free right modules of rank at least two are free (7.7);
* cancellation of free and finitely generated projective summands for modules
  of Ore rank at least two (7.13).
-/

namespace SymplecticStafford.Paper

open MulOpposite
open scoped nonZeroDivisors

namespace FilteredAlgebraData

variable {k U G : Type*} [Field k] [Ring U] [Algebra k U] [CommRing G] [Algebra k G]
variable {𝒜 : ℕ → Submodule k G} [GradedAlgebra 𝒜]
variable (D : FilteredAlgebraData k U G 𝒜)
variable [IsDomain G] [IsNoetherianRing G]

include D in
/-- The right Ore condition for all nonzero elements (Z1 at the zero prime). -/
theorem rightOre : RightOre U := by
  intro a b ha hb
  have := D.isDomain
  obtain ⟨t, ht, c, hc⟩ := D.ore_condition ⊥ a (s := b) ⟨hb, by simpa using D.sym_ne_zero hb⟩
  exact ⟨t, c, hc, mul_ne_zero ha ht.1⟩

include D in
/-- The left Ore condition, from the right Ore condition of `Uᵐᵒᵖ`. -/
theorem leftOre : LeftOre U := by
  intro a b ha hb
  obtain ⟨u, v, huv, hne⟩ := D.op.rightOre (MulOpposite.op a) (MulOpposite.op b) (by simpa using ha) (by simpa using hb)
  refine ⟨unop u, unop v, ?_, ?_⟩
  · simpa using congrArg unop huv
  · intro h; apply hne; apply unop_injective; simpa using h

include D in
/-- `U` has a right Ore localization at its nonzero elements. -/
theorem nonempty_oreSet : Nonempty (OreLocalization.OreSet (Uᵐᵒᵖ)⁰) := by
  have := D.isDomain
  exact ⟨oreSetOfRightOre D.rightOre⟩

variable [IsSimpleRing U] [Infinite k]

include D in
/-- The same-divisor property of `U` (Target theorem A with `B = 0`, `a = 1`). -/
theorem s38 (hdim : ringKrullDim G < ⊤) : S38 U := by
  intro d hd
  obtain ⟨H, R, S, h⟩ := D.targetA hdim d 1 hd one_ne_zero 0
  exact ⟨H, R, S, by simpa using h⟩

include D in
/-- The same-divisor property of `Uᵐᵒᵖ` (paper §7.7). -/
theorem s38_op (hdim : ringKrullDim G < ⊤) : S38 Uᵐᵒᵖ := D.op.s38 hdim

include D in
/-- **Theorem 7.1 for `U`.** Every finitely generated torsion right module is
cyclic. -/
theorem torsion_cyclic (hdim : ringKrullDim G < ⊤) {M : Type*} [AddCommGroup M]
    [Module Uᵐᵒᵖ M] [Module.Finite Uᵐᵒᵖ M] (hM : ∀ x : M, IsRightTorsion U x) :
    ∃ z : M, Submodule.span Uᵐᵒᵖ {z} = ⊤ := by
  have := D.isDomain
  exact isCyclic_of_forall_isRightTorsion D.rightOre (D.s38 hdim) hM

include D in
/-- **Theorem 7.6 for `U`.** Right stable range at most two. -/
theorem stable_range (hdim : ringKrullDim G < ⊤) {a b c : U}
    (h : Submodule.span Uᵐᵒᵖ {a, b, c} = ⊤) :
    ∃ f g : U, Submodule.span Uᵐᵒᵖ {a + c * f, b + c * g} = ⊤ := by
  have := D.isDomain
  exact stable_range_two D.rightOre D.leftOre (D.s38 hdim) h

include D in
/-- **Corollary 7.7 for `U`.** Stably free right modules of rank at least two
are free. -/
theorem stably_free (hdim : ringKrullDim G < ⊤) {M : Type*} [AddCommGroup M]
    [Module Uᵐᵒᵖ M] (m n : ℕ) (hmn : m + 2 ≤ n)
    (e : (M × (Fin m → U)) ≃ₗ[Uᵐᵒᵖ] (Fin n → U)) :
    Nonempty (M ≃ₗ[Uᵐᵒᵖ] (Fin (n - m) → U)) := by
  have := D.isDomain
  exact stably_free_is_free D.rightOre D.leftOre (D.s38 hdim) m n hmn e

include D in
/-- **Theorem 7.13 for `U`.** Cancellation of finitely generated projective
summands for finitely generated right modules of Ore rank at least two. -/
theorem cancellation (hdim : ringKrullDim G < ⊤) [OreLocalization.OreSet (Uᵐᵒᵖ)⁰]
    {M N P : Type*} [AddCommGroup M] [Module Uᵐᵒᵖ M] [Module.Finite Uᵐᵒᵖ M]
    [AddCommGroup N] [Module Uᵐᵒᵖ N] [AddCommGroup P] [Module Uᵐᵒᵖ P]
    [Module.Finite Uᵐᵒᵖ P] [Module.Projective Uᵐᵒᵖ P]
    (hM : 2 ≤ oreRank U M) (e : (M × P) ≃ₗ[Uᵐᵒᵖ] (N × P)) :
    Nonempty (M ≃ₗ[Uᵐᵒᵖ] N) := by
  have := D.isDomain
  exact cancellation_projective D.leftOre (D.s38_op hdim) hM e

end FilteredAlgebraData

end SymplecticStafford.Paper
