import Mathlib.RingTheory.SimpleRing.Basic
import Mathlib.RingTheory.TwoSidedIdeal.Operations
import Mathlib.Algebra.Algebra.Opposite
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Rings of right fractions

`IsRightFractions S ι` says that the ring homomorphism `ι : U →+* T` is
injective, sends `S` to units, and that every element of `T` is a right
fraction `ι a · (ι s)⁻¹` with `s ∈ S`.  This is the only interface of the
actual Ore localizations `T_𝔭` used in the manuscript's §§4–6.

We prove the elementary consequences used there: finite common right
denominators, clearing of extended right ideals, and the transfer of the domain
and simplicity properties (paper Lemma Z9).
-/

namespace SymplecticStafford.Paper

open MulOpposite

/-- `T` is a ring of right fractions of `U` with denominators in `S`. -/
structure IsRightFractions {U T : Type*} [Ring U] [Ring T] (S : Submonoid U) (ι : U →+* T) :
    Prop where
  injective : Function.Injective ι
  isUnit : ∀ s ∈ S, IsUnit (ι s)
  surj : ∀ τ : T, ∃ a : U, ∃ s ∈ S, τ * ι s = ι a

namespace IsRightFractions

variable {U T : Type*} [Ring U] [Ring T] {S : Submonoid U} {ι : U →+* T}
variable (h : IsRightFractions S ι)
include h

/-- The right Ore condition in `U`, recovered from right fractions. -/
lemma ore (c : U) {s : U} (hs : s ∈ S) : ∃ t ∈ S, ∃ b : U, c * t = s * b := by
  obtain ⟨u, hu⟩ := h.isUnit s hs
  obtain ⟨b, t, ht, hbt⟩ := h.surj (↑u⁻¹ * ι c)
  refine ⟨t, ht, b, h.injective ?_⟩
  rw [map_mul, map_mul, ← hbt, ← hu, ← mul_assoc, ← mul_assoc, Units.mul_inv, one_mul]

/-- Common right denominators for finite families. -/
lemma exists_common {n : ℕ} (τ : Fin n → T) :
    ∃ s ∈ S, ∀ i, ∃ a : U, τ i * ι s = ι a := by
  induction n with
  | zero => exact ⟨1, S.one_mem, fun i => i.elim0⟩
  | succ n ih =>
    obtain ⟨s, hs, ha⟩ := ih (fun i => τ i.castSucc)
    obtain ⟨b, t, ht, hbt⟩ := h.surj (τ (Fin.last n) * ι s)
    refine ⟨s * t, S.mul_mem hs ht, fun i => ?_⟩
    refine Fin.lastCases ?_ (fun j => ?_) i
    · exact ⟨b, by rw [map_mul, ← mul_assoc, hbt]⟩
    · obtain ⟨a, hsa⟩ := ha j
      exact ⟨a * t, by rw [map_mul, ← mul_assoc, hsa, map_mul]⟩

/-- Two elements admit a common right denominator. -/
lemma exists_common₂ (τ₁ τ₂ : T) :
    ∃ s ∈ S, ∃ a₁ a₂ : U, τ₁ * ι s = ι a₁ ∧ τ₂ * ι s = ι a₂ := by
  obtain ⟨s, hs, ha⟩ := h.exists_common ![τ₁, τ₂]
  obtain ⟨a₁, h₁⟩ := ha 0
  obtain ⟨a₂, h₂⟩ := ha 1
  exact ⟨s, hs, a₁, a₂, h₁, h₂⟩

/-- The right ideal of `T` generated by the image of a right ideal of `U`. -/
def extend (I : Submodule Uᵐᵒᵖ U) : Submodule Tᵐᵒᵖ T :=
  Submodule.span Tᵐᵒᵖ (ι '' I)

omit h in
lemma map_mem_extend {I : Submodule Uᵐᵒᵖ U} {a : U} (ha : a ∈ I) :
    ι a ∈ extend (ι := ι) I :=
  Submodule.subset_span ⟨a, ha, rfl⟩

/-- **Clearing.**  Every element of the extended right ideal becomes an
element of `ι I` after one right denominator. -/
lemma clear {I : Submodule Uᵐᵒᵖ U} {x : T} (hx : x ∈ extend (ι := ι) I) :
    ∃ s ∈ S, ∃ a ∈ I, x * ι s = ι a := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, ha, rfl⟩ := hy
    exact ⟨1, S.one_mem, a, ha, by simp⟩
  | zero => exact ⟨1, S.one_mem, 0, I.zero_mem, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨sx, hsx, ax, hax, hx⟩ := hx
    obtain ⟨sy, hsy, ay, hay, hy⟩ := hy
    obtain ⟨u, hu⟩ := h.isUnit sy hsy
    obtain ⟨b, t, ht, hbt⟩ := h.surj (↑u⁻¹ * ι sx)
    -- `sx * t = sy * b`
    have hst : ι (sx * t) = ι (sy * b) := by
      rw [map_mul, map_mul, ← hbt, ← hu, ← mul_assoc, ← mul_assoc, Units.mul_inv, one_mul]
    refine ⟨sx * t, S.mul_mem hsx ht, ax * t + ay * b, ?_, ?_⟩
    · refine I.add_mem ?_ ?_
      · simpa [op_smul_eq_mul] using I.smul_mem (op t) hax
      · simpa [op_smul_eq_mul] using I.smul_mem (op b) hay
    · have e1 : x * ι (sx * t) = ι (ax * t) := by rw [map_mul, ← mul_assoc, hx, map_mul]
      have e2 : y * ι (sx * t) = ι (ay * b) := by rw [hst, map_mul, ← mul_assoc, hy, map_mul]
      rw [add_mul, e1, e2, map_add]
  | smul r x _ hx =>
    obtain ⟨s, hs, a, ha, hxa⟩ := hx
    obtain ⟨u, hu⟩ := h.isUnit s hs
    obtain ⟨b, t, ht, hbt⟩ := h.surj (↑u⁻¹ * unop r)
    refine ⟨t, ht, a * b, ?_, ?_⟩
    · simpa [op_smul_eq_mul] using I.smul_mem (op b) ha
    · rw [smul_eq_mul_unop, map_mul, ← hxa, ← hbt, ← hu]
      simp only [mul_assoc, Units.mul_inv_cancel_left]

/-- An element of `U` whose image lies in the extended right ideal is
`S`-saturated into `I`. -/
lemma saturate {I : Submodule Uᵐᵒᵖ U} {a : U} (ha : ι a ∈ extend (ι := ι) I) :
    ∃ s ∈ S, a * s ∈ I := by
  obtain ⟨s, hs, b, hb, hab⟩ := h.clear ha
  refine ⟨s, hs, ?_⟩
  rw [← map_mul] at hab
  rwa [h.injective hab]

/-- `1` lies in the extended right ideal iff `I` meets `S`. -/
lemma one_mem_extend_iff {I : Submodule Uᵐᵒᵖ U} :
    (1 : T) ∈ extend (ι := ι) I ↔ ∃ s ∈ S, s ∈ I := by
  constructor
  · intro h1
    obtain ⟨s, hs, hsI⟩ := h.saturate (a := 1) (by rwa [map_one])
    exact ⟨s, hs, by simpa using hsI⟩
  · rintro ⟨s, hs, hsI⟩
    obtain ⟨u, hu⟩ := h.isUnit s hs
    have := (extend (ι := ι) I).smul_mem (op (↑u⁻¹ : T)) (map_mem_extend hsI)
    rwa [op_smul_eq_mul, ← hu, Units.mul_inv] at this

lemma eq_zero_of_mul_unit {x : T} {s : U} (hs : s ∈ S) (hx : x * ι s = 0) : x = 0 := by
  obtain ⟨u, hu⟩ := h.isUnit s hs
  rw [← hu] at hx
  simpa using congrArg (· * (↑u⁻¹ : T)) hx

lemma nontrivial [Nontrivial U] : Nontrivial T :=
  ⟨⟨ι 1, ι 0, fun e => one_ne_zero (h.injective e)⟩⟩

/-- The fraction ring of a domain has no zero divisors. -/
lemma noZeroDivisors [NoZeroDivisors U] : NoZeroDivisors T where
  eq_zero_or_eq_zero_of_mul_eq_zero {x y} hxy := by
    obtain ⟨a, s, hs, hxa⟩ := h.surj x
    obtain ⟨u, hu⟩ := h.isUnit s hs
    obtain ⟨b, t, ht, hyb⟩ := h.surj (↑u⁻¹ * y)
    have hab : ι (a * b) = 0 := by
      rw [map_mul, ← hxa, ← hyb, ← hu]
      simp only [mul_assoc, Units.mul_inv_cancel_left, ← mul_assoc x y, hxy, zero_mul]
    rw [← map_zero ι] at hab
    rcases mul_eq_zero.mp (h.injective hab) with ha | hb
    · left
      exact h.eq_zero_of_mul_unit hs (by rw [hxa, ha, map_zero])
    · right
      have : (↑u⁻¹ : T) * y = 0 := h.eq_zero_of_mul_unit ht (by rw [hyb, hb, map_zero])
      simpa using congrArg ((↑u : T) * ·) this

/-- The fraction ring of a domain is a domain. -/
lemma isDomain [IsDomain U] : IsDomain T :=
  haveI := h.nontrivial
  haveI := h.noZeroDivisors
  NoZeroDivisors.to_isDomain T

/-- The fraction ring of a simple ring is simple (paper Lemma Z9). -/
lemma isSimpleRing [IsSimpleRing U] : IsSimpleRing T := by
  haveI := h.nontrivial
  refine IsSimpleRing.of_eq_bot_or_eq_top fun J => ?_
  by_cases hJ : J = ⊥
  · exact Or.inl hJ
  right
  obtain ⟨x, hxJ, hx0⟩ := SetLike.exists_of_lt (bot_lt_iff_ne_bot.mpr hJ)
  have hx0 : x ≠ 0 := by
    intro e; apply hx0; rw [e]; exact (J.zero_mem : (0 : T) ∈ (⊥ : TwoSidedIdeal T))
  obtain ⟨a, s, hs, hxa⟩ := h.surj x
  have ha : a ≠ 0 := by
    rintro rfl
    exact hx0 (h.eq_zero_of_mul_unit hs (by rw [hxa, map_zero]))
  have haJ : a ∈ TwoSidedIdeal.comap ι J := by
    rw [TwoSidedIdeal.mem_comap, ← hxa]
    exact J.mul_mem_right _ _ hxJ
  have h1 := IsSimpleRing.one_mem_of_ne_zero_mem _ ha haJ
  rw [TwoSidedIdeal.mem_comap, map_one] at h1
  exact (TwoSidedIdeal.one_mem_iff J).mp h1

end IsRightFractions

end SymplecticStafford.Paper
