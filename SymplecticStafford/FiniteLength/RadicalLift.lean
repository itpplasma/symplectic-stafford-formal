import SymplecticStafford.FiniteLength.PencilBridge
import Mathlib.Tactic

/-!
# Explicit finite top lifting and activated relations

This file records two small, honest pieces of the finite-length argument.
`FiniteTopLifting` is an abstract finite descending filtration: at every
strict level a vector is a generated vector plus a vector one level lower.
The resulting theorem is a direct finite induction.  It does not construct a
radical, a finite-length filtration, or a semisimple top.

`ActivatedRelation` keeps the order of the two right factors visible.  From
the explicitly supplied identities `vL = 0` and `e = vB + uL`, together with
an explicit central-scalar compatibility, it derives the pencil relation used
by the activated-vector argument.  No arbitrary-module theorem is hidden in
the structure.
-/

namespace SymplecticStafford.FiniteLength

section TopLift

variable {R M : Type*} [Semiring R] [AddCommGroup M]
  [Module Rᵐᵒᵖ M]

/-/ Membership in the cyclic submodule generated by `m`, written without
introducing a quotient or a finiteness premise. -/
def RightGenerated (m x : M) : Prop :=
  ∃ r : Rᵐᵒᵖ, r • m = x

structure FiniteTopLifting (R M : Type*) [Semiring R] [AddCommGroup M]
    [Module Rᵐᵒᵖ M] (n : Nat) (m : M) where
  /-- The descending filtration terms. -/
  level : Nat → Set M
  /-- The initial term is the whole module. -/
  top : level 0 = Set.univ
  /-- The terminal term is zero. -/
  terminal : level n = ({0} : Set M)
  /-- A top-generated part can be peeled off at every strict level. -/
  step : ∀ i, i < n → ∀ x ∈ level i,
    ∃ y, RightGenerated (R := R) m y ∧ x - y ∈ level (i + 1)

private theorem rightGenerated_add {m x y : M}
    (hx : RightGenerated (R := R) m x)
    (hy : RightGenerated (R := R) m y) :
    RightGenerated (R := R) m (x + y) := by
  obtain ⟨r, hr⟩ := hx
  obtain ⟨s, hs⟩ := hy
  refine ⟨r + s, ?_⟩
  calc
    (r + s) • m = r • m + s • m := add_smul r s m
    _ = x + y := by rw [hr, hs]

private theorem rightGenerated_zero (m : M) :
    RightGenerated (R := R) m 0 := by
  exact ⟨0, by simp⟩

/-- Finite top lifting: the explicit one-step decomposition reaches the
cyclic submodule after finitely many levels. -/
theorem rightGenerated_of_finite_top_lifting {n : Nat} {m : M}
    (F : FiniteTopLifting R M n m) :
    ∀ x : M, RightGenerated (R := R) m x := by
  have hlevels : ∀ k : Nat, ∀ i : Nat, i ≤ n → n - i = k →
      ∀ x ∈ F.level i, RightGenerated (R := R) m x := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
        intro i hi hki x hxi
        by_cases hieq : i = n
        · subst i
          rw [F.terminal] at hxi
          simp only [Set.mem_singleton_iff] at hxi
          subst x
          exact rightGenerated_zero m
        · have hil : i < n := Nat.lt_of_le_of_ne hi hieq
          obtain ⟨y, hy, hz⟩ := F.step i hil x hxi
          have hnext : n - (i + 1) < k := by omega
          have hnextle : i + 1 ≤ n := by omega
          have hgenz : RightGenerated (R := R) m (x - y) :=
            ih (n - (i + 1)) hnext (i + 1) hnextle rfl (x - y) hz
          obtain ⟨r, hr⟩ := hy
          obtain ⟨s, hs⟩ := hgenz
          refine ⟨r + s, ?_⟩
          calc
            (r + s) • m = r • m + s • m := add_smul r s m
            _ = y + (x - y) := by rw [hr, hs]
            _ = x := by abel
  intro x
  apply hlevels (n - 0) 0 (Nat.zero_le n) (Nat.sub_zero n) x
  rw [F.top]
  exact Set.mem_univ x

/-- The finite top-lifting conclusion in the terminology used by the pencil
bridge: every vector is obtained by a right scalar from `m`. -/
theorem rightCyclic_of_finite_top_lifting {n : Nat} {m : M}
    (F : FiniteTopLifting R M n m) : RightCyclic (R := R) m := by
  intro x
  exact rightGenerated_of_finite_top_lifting F x

end TopLift

/-- From explicit right-action hypotheses `vL=0` and `e=vB+uL`, the
activated pencil satisfies the ordered relation
`(v+k*u)L + k*(vB) = k*e`.  The action is supplied explicitly, so this
lemma makes no claim that an arbitrary module has such a compatible action. -/
theorem pencil_right_action_add
    {K R M : Type*} [Field K] [Semiring R] [AddCommGroup M]
    [Module K M] (rightAction : R → M → M)
    (rightAction_add : ∀ (r : R) (x y : M),
      rightAction r (x + y) = rightAction r x + rightAction r y)
    (central_smul_right : ∀ (k : K) (m : M) (r : R),
      rightAction r (k • m) = k • rightAction r m)
    (v u e : M) (b l : R) (vL_zero : rightAction l v = 0)
    (e_decomp : e = rightAction b v + rightAction l u) (k : K) :
    rightAction l (v + k • u) + k • rightAction b v = k • e := by
  have hu : rightAction l (k • u) = k • rightAction l u :=
    central_smul_right k u l
  calc
    rightAction l (v + k • u) + k • rightAction b v =
        rightAction l v + rightAction l (k • u) +
          k • rightAction b v := by rw [rightAction_add]
    _ = k • rightAction l u + k • rightAction b v := by
      rw [vL_zero, zero_add, hu]
    _ = k • (rightAction b v + rightAction l u) := by
      rw [smul_add]
      abel
    _ = k • e := by rw [← e_decomp]

/-- The same ordered pencil relation solved for its first term. -/
theorem pencil_right_action_eq
    {K R M : Type*} [Field K] [Semiring R] [AddCommGroup M]
    [Module K M] (rightAction : R → M → M)
    (rightAction_add : ∀ (r : R) (x y : M),
      rightAction r (x + y) = rightAction r x + rightAction r y)
    (central_smul_right : ∀ (k : K) (m : M) (r : R),
      rightAction r (k • m) = k • rightAction r m)
    (v u e : M) (b l : R) (vL_zero : rightAction l v = 0)
    (e_decomp : e = rightAction b v + rightAction l u) (k : K) :
    rightAction l (v + k • u) = k • e - k • rightAction b v := by
  apply eq_sub_iff_add_eq.mpr
  exact pencil_right_action_add rightAction
    rightAction_add central_smul_right v u e b l vL_zero e_decomp k

end SymplecticStafford.FiniteLength

#print axioms SymplecticStafford.FiniteLength.rightGenerated_of_finite_top_lifting
#print axioms SymplecticStafford.FiniteLength.pencil_right_action_add
#print axioms SymplecticStafford.FiniteLength.pencil_right_action_eq
